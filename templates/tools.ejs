        // now playing
        var currentTrackData = null;
        var playlistContext = null;
        var filterContext = null;

        function loadTrackData(type, id) {
            fetch('/' + type + '/' + id + '?json=true')
                .then(function (r) { return r.json(); })
                .then(function (track) {
                    track.type = type;
                    updateNowPlaying(track);

                    // update playlist index if we have a playlist context
                    if (playlistContext && playlistContext.tracks) {
                        var newIndex = -1;

                        for (var i = 0; i < playlistContext.tracks.length; i++) {
                            var t = playlistContext.tracks[i];
                            var trackCanonical = track.canonical || track.canonicalId || track.id;
                            var playlistTrackCanonical = t.canonical || t.id;

                            // match by canonical
                            if (trackCanonical && playlistTrackCanonical &&
                                String(trackCanonical) === String(playlistTrackCanonical)) {
                                newIndex = i;
                                break;
                            }

                            // match by type + id
                            if (t.type === type && String(t.id) === String(id)) {
                                newIndex = i;
                                break;
                            }

                            // match by urlType + urlId
                            if (t.urlType === type && String(t.urlId) === String(id)) {
                                newIndex = i;
                                break;
                            }
                        }

                        if (newIndex >= 0) {
                            playlistContext.currentIndex = newIndex;
                        }
                        updatePlaylistUI();
                    } else if (!filterContext) {
                        // no playlist or filter - check adjacent tracks for button state
                        checkAdjacentTracks();
                    }
                })
                .catch(function (e) {
                    console.error('Failed to load track:', e);
                });
        }

        function setPlaylistContext(playlist, currentTrackId) {
            if (!playlist || !playlist.tracks || playlist.tracks.length === 0) {
                playlistContext = null;
                updatePlaylistUI();
                return;
            }

            var isSamePlaylist = playlistContext &&
                (playlistContext.id === (playlist.canonical || playlist.id));

            var currentIndex = 0;

            if (isSamePlaylist && playlistContext.currentIndex !== undefined) {
                currentIndex = playlistContext.currentIndex;
            } else if (currentTrackId) {
                for (var i = 0; i < playlist.tracks.length; i++) {
                    var t = playlist.tracks[i];
                    if (String(t.id) === String(currentTrackId) ||
                        t.canonical === currentTrackId ||
                        String(t.urlId) === String(currentTrackId)) {
                        currentIndex = i;
                        break;
                    }
                }
            }

            playlistContext = {
                id: playlist.canonical || playlist.id,
                name: playlist.name,
                tracks: playlist.tracks,
                currentIndex: currentIndex
            };

            filterContext = null;
            updatePlaylistUI();
        }

        function setFilterContext(context) {
            if (!context) {
                filterContext = null;
                updateFilterUI();
                return;
            }

            filterContext = {
                type: context.type || 'db',
                player: context.player || null,
                query: context.query || null,
                remixesOf: context.remixesOf || null,
                sortBy: context.sortBy || 'shuffle',
                sortOrder: context.sortOrder || 'desc'
            };

            playlistContext = null;
            updateFilterUI();
        }

        function updatePlaylistUI() {
            var infoEl = document.getElementById('np-playlist-info');
            var nameEl = document.getElementById('np-playlist-name');
            var posEl = document.getElementById('np-playlist-position');
            var prevBtn = document.getElementById('np-prev');
            var nextBtn = document.getElementById('np-next');

            if (playlistContext && playlistContext.tracks && playlistContext.tracks.length > 0) {
                infoEl.style.display = 'block';
                infoEl.style.cursor = 'pointer';
                nameEl.textContent = playlistContext.name;
                nameEl.style.cursor = 'pointer';
                nameEl.title = 'Open playlist';
                posEl.textContent = '(' + (playlistContext.currentIndex + 1) + '/' + playlistContext.tracks.length + ')';

                var hasPrev = playlistContext.currentIndex > 0;
                var hasNext = playlistContext.currentIndex < playlistContext.tracks.length - 1;

                prevBtn.disabled = !hasPrev;
                nextBtn.disabled = !hasNext;
                prevBtn.style.opacity = hasPrev ? '1' : '0.5';
                nextBtn.style.opacity = hasNext ? '1' : '0.5';
                prevBtn.title = hasPrev ? 'Previous in playlist' : 'At start of playlist';
                nextBtn.title = hasNext ? 'Next in playlist' : 'At end of playlist';
            } else {
                infoEl.style.display = 'none';
                updateFilterUI();
            }
        }

        function updateFilterUI() {
            var infoEl = document.getElementById('np-playlist-info');
            var nameEl = document.getElementById('np-playlist-name');
            var posEl = document.getElementById('np-playlist-position');
            var prevBtn = document.getElementById('np-prev');
            var nextBtn = document.getElementById('np-next');

            if (filterContext && (filterContext.player || filterContext.type !== 'db' || filterContext.query || filterContext.remixesOf)) {
                infoEl.style.display = 'block';
                infoEl.style.cursor = 'pointer';

                var label = '';
                var title = '';
                if (filterContext.remixesOf) {
                    var remixName = filterContext.remixesOf.name || filterContext.remixesOf.canonical;
                    label = 'Remixes of ' + remixName;
                    title = 'Open remixes';
                } else if (filterContext.player) {
                    label = filterContext.player;
                    title = 'Open player page';
                } else if (filterContext.query) {
                    label = filterContext.query;
                    title = 'Open search';
                } else if (filterContext.type && filterContext.type !== 'db') {
                    label = filterContext.type.toUpperCase();
                    title = 'Open ' + filterContext.type.toUpperCase() + ' tracks';
                }

                nameEl.textContent = label;
                nameEl.style.cursor = 'pointer';
                nameEl.title = title;
                var sortLabel = filterContext.sortBy && filterContext.sortBy !== 'shuffle'
                    ? filterContext.sortBy
                    : 'shuffle';
                if (filterContext.sortOrder && filterContext.sortOrder !== 'desc' && sortLabel !== 'shuffle') {
                    sortLabel += ' ' + filterContext.sortOrder;
                }
                posEl.textContent = '(' + sortLabel + ')';

                prevBtn.disabled = true;
                nextBtn.disabled = true;
                prevBtn.style.opacity = '0.5';
                nextBtn.style.opacity = '0.5';
            } else if (!playlistContext) {
                infoEl.style.display = 'none';

                if (currentTrackData) {
                    prevBtn.disabled = false;
                    nextBtn.disabled = false;
                    prevBtn.style.opacity = '1';
                    nextBtn.style.opacity = '1';
                    prevBtn.title = 'Previous track';
                    nextBtn.title = 'Next track';
                } else {
                    prevBtn.disabled = true;
                    nextBtn.disabled = true;
                    prevBtn.style.opacity = '0.5';
                    nextBtn.style.opacity = '0.5';
                }
            }
        }

        var currentPlayer = null;

        function showPlayerProfile(playerName) {
            fetch('/api/player/' + encodeURIComponent(playerName))
                .then(function (res) { return res.json(); })
                .then(function (player) {
                    currentPlayer = player;

                    document.getElementById('now-playing-wrapper').style.display = 'none';
                    document.getElementById('player-profile').style.display = 'block';

                    var avatar = document.getElementById('player-avatar');
                    avatar.style.display = '';
                    avatar.src = player.avatar;
                    avatar.onerror = function () {
                        this.style.display = 'none';
                    };

                    document.getElementById('player-name').textContent = player.displayName;

                    var aliasesEl = document.getElementById('player-aliases');
                    var otherAliases = (player.aliases || []).filter(function (a) {
                        return a.toLowerCase() !== player.displayName.toLowerCase();
                    });
                    if (otherAliases.length > 0) {
                        aliasesEl.textContent = 'Also known as: ' + otherAliases.join(', ');
                        aliasesEl.style.display = '';
                    } else {
                        aliasesEl.style.display = 'none';
                    }

                    document.getElementById('player-stats').textContent = player.trackCount + ' track' + (player.trackCount !== 1 ? 's' : '') + ' in database';

                    var platformsEl = document.getElementById('player-platforms');
                    var platformBadges = [];
                    if (player.platforms.frhd) platformBadges.push('<span class="track-type-badge frhd">FRHD</span>');
