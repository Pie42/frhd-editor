        // ---- Build Functions ----

        function buildModList(modVars) {
            if (modListBuilt) return;
            modListBuilt = true;

            var container = document.getElementById('mod-settings-list');
            container.innerHTML = '';

            modLayout.forEach(function (item) {
                container.appendChild(buildModFolder(item, modVars));
            });

            updateColorDisabledState();
        }

        function buildModFolder(folder, modVars) {
            var details = document.createElement('details');
            details.className = 'mod-folder';

            var summary = document.createElement('summary');
            summary.className = 'mod-folder-title';
            summary.textContent = folder.title;
            details.appendChild(summary);

            var inner = document.createElement('div');
            inner.className = 'mod-folder-inner';

            var settingsCol = document.createElement('div');
            settingsCol.className = 'mod-folder-settings';

            var descCol = document.createElement('div');
            descCol.className = 'mod-folder-description';
            descCol.textContent = modFolderDescriptions[folder.title] || 'Hover over a setting.';

            function setDesc(text) {
                if (text) {
                    descCol.textContent = text;
                    descCol.classList.add('active');
                } else {
                    descCol.textContent = modFolderDescriptions[folder.title] || 'Hover over a setting.';
                    descCol.classList.remove('active');
                }
            }

            (folder.keys || []).forEach(function (key) {
                settingsCol.appendChild(
                    buildModCheckbox(key, modTitles[key] || key, modVars, setDesc)
                );
            });

            (folder.colors || []).forEach(function (key) {
                settingsCol.appendChild(
                    buildModColorInput(key, modTitles[key] || key, modVars, setDesc)
                );
            });

            inner.appendChild(settingsCol);
            inner.appendChild(descCol);
            details.appendChild(inner);
            return details;
        }

        function buildModCheckbox(key, title, modVars, setDesc) {
            var row = document.createElement('div');
            row.className = 'mod-setting-row';

            var checkbox = document.createElement('input');
            checkbox.type = 'checkbox';
            checkbox.id = 'mod-' + key;
            checkbox.checked = !!modVars[key];

            var label = document.createElement('label');
            label.style.cursor = 'pointer';
            label.textContent = title;

            checkbox.addEventListener('change', function () {
                send('mod-' + key, this.checked);
                if (key === 'customColors') updateColorDisabledState();
            });

            row.addEventListener('click', function (e) {
                if (e.target !== checkbox) {
                    checkbox.checked = !checkbox.checked;
                    send('mod-' + key, checkbox.checked);
                    if (key === 'customColors') updateColorDisabledState();
                }
            });

            if (setDesc) {
                row.addEventListener('mouseenter', function () {
                    setDesc(modDescriptions[key] || '');
                });
                row.addEventListener('mouseleave', function () {
                    setDesc(null);
                });
            }

            row.appendChild(checkbox);
            row.appendChild(label);
            return row;
        }

        function buildModColorInput(key, title, modVars, setDesc) {
            var row = document.createElement('div');
            row.className = 'mod-setting-row';

            var label = document.createElement('span');
            label.textContent = title;
            label.style.cssText = 'font-size: 11px; flex: 1;';
            label.style.cursor = 'pointer';
            label.addEventListener('click', function () {
                colorInput.click();
            });

            var colorLabel = document.createElement('label');
            colorLabel.className = 'layer-color-label';
            colorLabel.style.cssText = 'margin-right: 6px; flex-shrink: 0;';

            var swatch = document.createElement('span');
            swatch.className = 'layer-color-swatch';
            var color = modVars[key] || [0, 0, 0];
            swatch.style.background = rgbToHex(color);
            swatch.title = title;

            var colorInput = document.createElement('input');
            colorInput.type = 'color';
            colorInput.className = 'layer-color-input';
            colorInput.id = 'mod-' + key;
            colorInput.value = rgbToHex(color);

            colorInput.addEventListener('input', function () {
                swatch.style.background = this.value;
                send('mod-' + key, hexToRgb(this.value));
            });

            colorInput.addEventListener('click', function (e) {
                e.stopPropagation();
            });

            colorLabel.appendChild(swatch);
            colorLabel.appendChild(colorInput);

            if (setDesc) {
                row.addEventListener('mouseenter', function () {
                    setDesc(modDescriptions[key] || '');
                });
                row.addEventListener('mouseleave', function () {
                    setDesc(null);
                });
            }

            row.appendChild(colorLabel);
            row.appendChild(label);
            return row;
        }

        function updateColorDisabledState() {
            var cb = document.getElementById('mod-customColors');
            var enabled = cb && cb.checked;
            var colorKeys = ['vehicleColor', 'riderColor', 'lineColor',
                'sceneryColor', 'backgroundColor'];
            colorKeys.forEach(function (key) {
                var el = document.getElementById('mod-' + key);
                if (!el) return;
                var row = el.closest('.mod-setting-row');
                if (!row) return;
                if (enabled) {
                    row.style.opacity = '1';
                    row.style.pointerEvents = '';
                } else {
                    row.style.opacity = '0.35';
                    row.style.pointerEvents = 'none';
                }
            });
        }

        // ---- Helpers ----

        function rgbToHex(rgb) {
            return '#' + rgb.map(function (c) {
                return ('0' + Math.max(0, Math.min(255, c)).toString(16)).slice(-2);
            }).join('');
        }

        function hexToRgb(hex) {
            var r = parseInt(hex.slice(1, 3), 16);
            var g = parseInt(hex.slice(3, 5), 16);
            var b = parseInt(hex.slice(5, 7), 16);
            return [r, g, b];
        }

        // ---- Update from Parent ----

        function updateModSettings(modVars) {
            if (!modVars) return;

            buildModList(modVars);

            for (var key in modVars) {
                var el = document.getElementById('mod-' + key);
                if (!el) continue;

                if (el.type === 'checkbox') {
                    el.checked = !!modVars[key];
                } else if (el.type === 'color') {
                    var hex = rgbToHex(modVars[key] || [0, 0, 0]);
                    el.value = hex;
                    var swatch = el.previousElementSibling;
                    if (swatch && swatch.classList.contains('layer-color-swatch')) {
                        swatch.style.background = hex;
                    }
                }
            }

            if (modVars.play !== undefined) {
                var vPlay = document.getElementById('vehicle-mod-play');
                if (vPlay) vPlay.classList.toggle('engaged', !!modVars.play);
            }
            if (modVars.mobile !== undefined) {
                var vMobile = document.getElementById('vehicle-mod-mobile');
                if (vMobile) vMobile.classList.toggle('engaged', !!modVars.mobile);
            }

            updateColorDisabledState();
        }

        // Request settings on load
        if (window.parent !== window) {
            window.parent.postMessage({ action: 'requestSettings' }, '*');
        }

        document.body.addEventListener('click', function (e) {
            // skip focus for settings inputs and sliders
            if (e.target.closest('.settingInput') ||
                e.target.closest('.horizontal-slider-container-2') ||
                e.target.closest('input[type="range"]') ||
                e.target.closest('input[type="color"]') ||
                e.target.closest('.layer-color-input') ||
                e.target.closest('.layer-color-label') ||
                e.target.closest('.toolSettings-input')) {
                return;
            }

            if (window.parent && window.parent.focus) {
                window.parent.focus();
            }
        }, false);

        document.addEventListener('keydown', function (e) {
            if (e.key.length === 1 && !e.ctrlKey && !e.metaKey && !e.altKey) {
                var active = document.activeElement;
                if (active && active.tagName === 'SELECT') {
                    active.blur();
                    window.parent.focus();
                }
            }
        });

        window.lastObjectPreviewData = null;
        window.lastPatternPreviewData = null;

        // resize handler
        var resizeTimeout;
        window.addEventListener('resize', function () {
            clearTimeout(resizeTimeout);
            resizeTimeout = setTimeout(function () {
                if (window.lastObjectPreviewData) {
                    drawObjectPreview(window.lastObjectPreviewData);
                }

                if (window.lastPatternPreviewData) {
                    var brushType = parseInt(document.getElementById('pattern-brush').value) || 1;
                    drawPatternPreview(window.lastPatternPreviewData, brushType);
                }
            }, 0);
        });

        (function () {
            try {
                var parentPath = window.parent.location.pathname;
                var match = parentPath.match(/^\/(frhd|bhr|cr|tm|app|t)\/([a-zA-Z0-9_-]+)/);
                if (match) {
                    loadTrackData(match[1], match[2]);
                }
            } catch (e) {
                // cross-origin, wait for message
            }
        })();
    </script>
</body>

</html>