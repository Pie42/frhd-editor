                    playlistContext = null;
                    updatePlaylistUI();
                }
            },
            'setFilterContext': function (data) {
                if (data.filterContext) {
                    setFilterContext(data.filterContext);
                } else {
                    filterContext = null;
                    updateFilterUI();
                }
            },
            'showPlayerProfile': function (data) {
                showPlayerProfile(data.player);
            },
            'showToolTab': function (data) {
                var tool = data.tool;

                var toolToTab = {
                    'straightline': 'tool', 'curve': 'tool', 'circle': 'tool',
                    'brush': 'tool', 'pattern': 'tool', 'eraser': 'tool',
                    'powerup': 'tool', 'vehiclepowerup': 'tool', 'select': 'tool',
                    'camera': 'tool', 'grid': 'grid', 'snap': 'snap',
                    'object': 'object', 'layer': 'layer', 'vehicle': 'vehicle',
                    'mod': 'mods', 'mods': 'mods',
                };

                var tabName = toolToTab[tool] || 'tool';

                var toolbox = document.getElementById('toolbox-content');
                if (toolbox && toolbox.style.display === 'none') {
                    var toolboxBtn = document.querySelector('.bottom-bar-button[data-panel="toolbox"]');
                    if (toolboxBtn) toolboxBtn.click();
                }

                switchTab(tabName);
                if (tabName === 'tool') setCurrentTool(tool);
            },
            'enterDialogMode': function (data) {
                document.body.classList.add('dialog-mode');
            },
            'exitDialogMode': function (data) {
                document.body.classList.remove('dialog-mode');
            },
            'ghostUploaded': function () {
                var btn = document.getElementById('np-ghost-upload');
                if (btn) {
                    btn.textContent = 'Uploaded!';
                    setTimeout(function () { btn.textContent = 'Upload Ghost'; }, 1500);
                }
                if (currentTrackData) {
                    var ghostType = currentTrackData.type || 'db';
                    var ghostId = currentTrackData.canonical || currentTrackData.id;
                    fetchTrackGhosts(ghostType, ghostId);
                }
            },
            'ghostUploadFailed': function () {
                var btn = document.getElementById('np-ghost-upload');
