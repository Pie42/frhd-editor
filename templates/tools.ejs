    <script>
        var state = {
            copyMode: false,
            ellipseMode: true,
            lineTrimMode: false,
            cameraLockMode: false,
            currentTab: 'tool'
        };

        var avatarCache = {};

        function fetchAuthorAvatar(authorName, callback) {
            if (avatarCache[authorName] !== undefined) {
                callback(avatarCache[authorName]);
                return;
            }

            fetch('/api/player/' + encodeURIComponent(authorName))
                .then(function (res) { return res.json(); })
                .then(function (player) {
                    avatarCache[authorName] = player.avatar || null;
                    callback(avatarCache[authorName]);
                })
                .catch(function () {
                    avatarCache[authorName] = null;
                    callback(null);
                });
        }

        document.querySelectorAll('.tab-button').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var tabName = this.getAttribute('data-tab');
                switchTab(tabName);
            });
        });

        document.querySelectorAll('.bottom-bar-button').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var panel = this.dataset.panel;

                document.querySelectorAll('.bottom-bar-button').forEach(function (b) {
                    b.classList.remove('active');
                });
                this.classList.add('active');

                var toolbox = document.getElementById('toolbox-content');
                var chat = document.getElementById('forum-content');

                if (panel === 'forum') {
                    toolbox.style.display = 'none';
                    chat.style.display = 'block';
                    document.querySelector('.editorDialog-tools').style.overflowY = 'hidden';
                    var iframe = document.getElementById('forum-iframe');
                    if (!iframe.dataset.loaded) {
                        iframe.src = 'https://forum.freerider.app/';
                        iframe.dataset.loaded = 'true';
                    }
                } else {
                    chat.style.display = 'none';
                    toolbox.style.display = '';
                    document.querySelector('.editorDialog-tools').style.overflowY = 'scroll';
                }

                window.parent.focus();
            });
        });

        document.getElementById('bottom-bar').style.display = '';
        document.querySelector('.editorDialog-tools').classList.add('has-bottom-bar');

        function switchTab(tabName) {
            state.currentTab = tabName;

            document.querySelectorAll('.tab-button').forEach(function (btn) {
                btn.classList.remove('active');
                if (btn.getAttribute('data-tab') === tabName) {
                    btn.classList.add('active');
                }
            });

            document.querySelectorAll('.tab-content').forEach(function (content) {
                content.classList.remove('active');
            });
            document.getElementById('tab-' + tabName).classList.add('active');

            if (tabName === 'forum') {
                var forumIframe = document.getElementById('forum-iframe');
                if (!forumIframe.dataset.loaded) {
                    forumIframe.src = 'https://forum.freerider.app/chat';
                    forumIframe.dataset.loaded = 'true';
                }

            }
            window.parent.focus();
        }

        function toggleCopy() {
            state.copyMode = !state.copyMode;
            document.getElementById('btn-copy').textContent = state.copyMode ? 'COPY + PASTE' : 'CUT + PASTE';
            send('select-copy', state.copyMode);
        }

        function toggleEllipse() {
            state.ellipseMode = !state.ellipseMode;
            document.getElementById('btn-ellipse').textContent = state.ellipseMode ? 'Ellipse' : 'Circle';
            send('circle-ellipse', state.ellipseMode);
        }

        function toggleLineTrim() {
            state.lineTrimMode = !state.lineTrimMode;
            document.getElementById('btn-lineTrim').textContent = state.lineTrimMode ? 'Line Trim' : 'Line Erase';
            send('eraser-lineTrim', state.lineTrimMode);
        }

        /*function toggleCameraLock() {
            state.cameraLockMode = !state.cameraLockMode;
            document.getElementById('btn-cameraLock').textContent = state.cameraLockMode ? 'Camera Locked' : 'Camera Unlocked';
            send('camera-locked', state.cameraLockMode);
        }*/

        function send(id, value) {
            if (window.parent !== window) {
                window.parent.postMessage({ action: 'toolOptionChange', option: id, value: value }, '*');
            }
            window.parent.focus();
        }

        function updateLineTypeBadge(lineType, objectMode) {
            var badges = document.querySelectorAll('.line-type-badge');

            badges.forEach(function (badge) {
                badge.className = 'line-type-badge mode-badge';

                if (!lineType) {
                    badge.textContent = 'OBJECT';
                    badge.classList.add('object');
                } else if (lineType === 'scenery') {
                    badge.textContent = 'SCENERY';
                    badge.classList.add('scenery');
                } else {
                    badge.textContent = 'PHYSICS';
                    badge.classList.add('physics');
                }
            });
        }

        function updateGridSettings(s) {
            if (s.gridSize !== undefined) {
                document.getElementById('grid-size').value = s.gridSize;
            }
            if (s.gridType !== undefined) {
                document.getElementById('grid-type').value = s.gridType;
            }
            if (s.gridVisibility !== undefined) {
                document.getElementById('grid-visibility').value = s.gridVisibility;
            }

            var gridToggle = document.getElementById('grid-toggle');
            if (gridToggle && s.gridActive !== undefined) {
                if (s.gridActive) {
                    gridToggle.className = 'toggle-icon editorgui_icons editorgui_icons-icon_grid_on active';
                } else {
                    gridToggle.className = 'toggle-icon editorgui_icons_bottom editorgui_icons-icon_grid_off';
                }
            }
        }

        function updateSnapSettings(s) {
            if (s.snapDistance !== undefined) {
                document.getElementById('snap-distance').value = s.snapDistance;
            }
            if (s.snapType !== undefined) {
                document.getElementById('snap-type').value = s.snapType;
            }
            if (s.snapCursor !== undefined) {
                document.getElementById('snap-cursor').value = s.snapCursor ? 'cross' : 'dot';
            }

            var snapToggle = document.getElementById('snap-toggle');
            if (snapToggle && s.snapActive !== undefined) {
                if (s.snapActive) {
                    snapToggle.className = 'toggle-icon editorgui_icons editorgui_icons-icon_snapbottom_on active';
                } else {
                    snapToggle.className = 'toggle-icon editorgui_icons_bottom editorgui_icons-icon_snapbottom';
                }
            }
        }

        function updateCameraSettings(s) {
            if (s.cameraSensitivity !== undefined) {
                document.getElementById('camera-sensitivity').value = s.cameraSensitivity;
            }
            if (s.cameraMovement !== undefined) {
                document.getElementById('camera-movement').value = s.cameraMovement;
            }
            if (s.cameraSpeed !== undefined) {
                document.getElementById('camera-speed').value = s.cameraSpeed;
            }

            var cameraLockToggle = document.getElementById('camera-lock-toggle');
            if (cameraLockToggle && s.cameraLocked !== undefined) {
                state.cameraLockMode = s.cameraLocked;
                if (s.cameraLocked) {
                    cameraLockToggle.className = 'toggle-icon editorgui_icons_bottom editorgui_icons-icon_camera_lock_on active';
                } else {
                    cameraLockToggle.className = 'toggle-icon editorgui_icons_bottom editorgui_icons-icon_camera_lock_off';
                }
            }
        }

        function updateLayerSettings(s) {
            var layerList = document.getElementById('layer-list');

            if (s.layers !== undefined && layerList) {
                var existingItems = layerList.querySelectorAll('.layer-item');
                var canUpdateInPlace = existingItems.length === s.layers.length;

                if (canUpdateInPlace) {
                    s.layers.forEach(function (layer, index) {
                        var item = existingItems[index];
                        var isActive = index === s.currentLayerIndex;
                        var isVisible = layer.visible !== false;
                        var isLocked = layer.locked || false;

                        if (isActive) {
                            item.classList.add('active');
                        } else {
                            item.classList.remove('active');
                        }

                        var nameText = item.querySelector('.layer-name-text');
                        if (nameText && nameText.textContent !== layer.name) {
                            nameText.textContent = layer.name;
                        }

                        var physicsSwatch = item.querySelector('.layer-color-swatch.physics');
                        if (physicsSwatch) {
                            physicsSwatch.style.background = layer.physicsColor || '#000000';
                        }
                        var scenerySwatch = item.querySelector('.layer-color-swatch.scenery');
                        if (scenerySwatch) {
                            scenerySwatch.style.background = layer.sceneryColor || '#aaaaaa';
                        }

                        var lockBtn = item.querySelector('.layer-btn.lock');
                        if (lockBtn) {
                            if (isLocked) {
                                lockBtn.classList.add('layer-locked');
                                lockBtn.title = 'Unlock';
                            } else {
                                lockBtn.classList.remove('layer-locked');
                                lockBtn.title = 'Lock';
                            }
                        }

                        var eyeBtn = item.querySelector('.layer-btn.eye');
                        if (eyeBtn) {
                            if (isVisible) {
                                eyeBtn.classList.remove('layer-hidden');
                                eyeBtn.title = 'Hide';
                            } else {
                                eyeBtn.classList.add('layer-hidden');
                                eyeBtn.title = 'Show';
                            }
                        }
                    });
                    return; // don't rebuild
                }

                // full rebuild if layer count changed
                layerList.innerHTML = '';

                s.layers.forEach(function (layer, index) {
                    var isActive = index === s.currentLayerIndex;
                    var isVisible = layer.visible !== false;
                    var isLocked = layer.locked || false;
                    var canDelete = index > 0;
                    var canMergeInto = !isActive;
                    var physicsColor = layer.physicsColor || '#000000';
                    var sceneryColor = layer.sceneryColor || '#aaaaaa';

                    var item = document.createElement('div');
                    item.className = 'layer-item' + (isActive ? ' active' : '');
                    item.dataset.index = index;

                    item.innerHTML =
                        '<span class="layer-name"><span class="layer-name-text" title="Click to rename">' + layer.name + '</span></span>' +
                        '<div class="layer-colors">' +
                        '<label class="layer-color-label">' +
                        '<span class="layer-color-swatch physics" style="background:' + physicsColor + '" title="Physics Color"></span>' +
                        '<input type="color" class="layer-color-input" data-type="physics" title="Physics lines" data-index="' + index + '" value="' + physicsColor + '">' +
                        '</label>' +
                        '<label class="layer-color-label">' +
                        '<span class="layer-color-swatch scenery" style="background:' + sceneryColor + '" title="Scenery Color"></span>' +
                        '<input type="color" class="layer-color-input" data-type="scenery" title="Scenery lines" data-index="' + index + '" value="' + sceneryColor + '">' +
                        '</label>' +
                        '</div>' +
                        '<div class="layer-actions">' +
                        '<button class="layer-btn eye' + (isVisible ? '' : ' layer-hidden') + '" data-action="toggle" title="' + (isVisible ? 'Hide' : 'Show') + '" type="button">👁</button>' +
                        '<button class="layer-btn lock' + (isLocked ? ' layer-locked' : '') + '" data-action="lock" title="' + (isLocked ? 'Unlock layer' : 'Lock layer') + '" type="button"></button>' +
                        '<button class="layer-btn merge" data-action="merge" title="Merge current layer into this" type="button"></button>' +
                        (canDelete ? '<button class="layer-btn clear" data-action="delete" title="Delete" type="button"></button>' : '') +
                        '</div>';

                    item.addEventListener('click', function (e) {
                        send('layer-select', index);
                    });

                    var nameText = item.querySelector('.layer-name-text');
                    if (nameText) {
                        nameText.addEventListener('click', function (e) {
                            e.stopPropagation();
                            var newName = prompt('Rename layer:', layer.name);
                            if (newName && newName !== layer.name) {
                                send('layer-rename-index', { index: index, name: newName });
                            }
                            window.parent.focus();
                        });
                    }

                    item.querySelectorAll('.layer-color-input').forEach(function (input) {
                        input.addEventListener('input', function (e) {
                            e.stopPropagation();
                            var type = this.dataset.type;
                            var idx = parseInt(this.dataset.index);
                            var color = this.value;

                            this.previousElementSibling.style.background = color;

                            send('layer-color-' + type + '-index', { index: idx, color: color });
                        });

                        input.addEventListener('click', function (e) {
                            e.stopPropagation();
                        });
                    });

                    var mergeBtn = item.querySelector('.layer-btn.merge');
                    if (mergeBtn) {
                        mergeBtn.addEventListener('click', function (e) {
                            e.stopPropagation();
                            send('layer-merge-into', index);
                        });
                    }

                    var lockBtn = item.querySelector('.layer-btn.lock');
                    if (lockBtn) {
                        lockBtn.addEventListener('click', function (e) {
                            e.stopPropagation();
                            send('layer-lock', index);
                        });
                    }

                    var eyeBtn = item.querySelector('.layer-btn.eye');
                    if (eyeBtn) {
                        eyeBtn.addEventListener('click', function (e) {
                            e.stopPropagation();
                            send('layer-toggle-index', index);
                        });
                    }

                    var deleteBtn = item.querySelector('.layer-btn.clear');
                    if (deleteBtn) {
                        deleteBtn.addEventListener('click', function (e) {
                            e.stopPropagation();
                            send('layer-delete-index', index);
                        });
                    }

                    layerList.appendChild(item);
                });
            }
        }

        function drawObjectPreview(data) {
            window.lastObjectPreviewData = data;
            var canvas = document.getElementById('object-preview-canvas');
            if (!canvas) return;

            var wrapper = canvas.parentElement;
            var displayWidth = wrapper.clientWidth || 150;
            var displayHeight = wrapper.clientHeight || 150;

            var dpr = window.devicePixelRatio || 1;

            canvas.width = displayWidth * dpr;
            canvas.height = displayHeight * dpr;

            var ctx = canvas.getContext('2d');
            ctx.scale(dpr, dpr);

            var width = displayWidth;
            var height = displayHeight;
            var centerX = width / 2;
            var centerY = height / 2;

            ctx.fillStyle = '#FFF';
            ctx.fillRect(0, 0, width, height);

            var physics = data.physics || [];
            var scenery = data.scenery || [];
            var powerups = data.powerups || [];

            if (physics.length === 0 && scenery.length === 0 && powerups.length === 0) {
                ctx.fillStyle = '#999';
                ctx.font = '12px sans-serif';
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';
                ctx.fillText('No preview', centerX, centerY);
                return;
            }

            // calculate maximum distance from origin to encompass object in preview circle no matter rotation
            var maxRadius = 0;

            var powerupSizes = {
                'goal': 13,
                'slowmo': 13,
                'checkpoint': 13,
                'bomb': 10,
                'gravity': Math.sqrt(1000) * 0.5,
                'boost': Math.sqrt(1000) * 0.5,
                'antigravity': Math.sqrt(1000) * 0.5,
                'teleport': Math.sqrt(1000) * 0.5,
                'helicopter': 15,
                'truck': 15,
                'balloon': 15,
                'blob': 15
            };

            physics.forEach(function (line) {
                var d1 = Math.sqrt(line.x1 * line.x1 + line.y1 * line.y1);
                var d2 = Math.sqrt(line.x2 * line.x2 + line.y2 * line.y2);
                maxRadius = Math.max(maxRadius, d1, d2);
            });

            scenery.forEach(function (line) {
                var d1 = Math.sqrt(line.x1 * line.x1 + line.y1 * line.y1);
                var d2 = Math.sqrt(line.x2 * line.x2 + line.y2 * line.y2);
                maxRadius = Math.max(maxRadius, d1, d2);
            });

            powerups.forEach(function (p) {
                var pSize = powerupSizes[p.name] || 10;
                var d = Math.sqrt(p.x * p.x + p.y * p.y) + pSize;
                maxRadius = Math.max(maxRadius, d);
                if (p.x2 !== undefined && p.y2 !== undefined) {
                    var d2 = Math.sqrt(p.x2 * p.x2 + p.y2 * p.y2) + pSize;
                    maxRadius = Math.max(maxRadius, d2);
                }
            });

            var padding = 10;
            var availableRadius = Math.min(width, height) / 2 - padding;

            var objScale = maxRadius > 0 ? availableRadius / maxRadius : 1;
            objScale = Math.min(objScale, 2);

            ctx.strokeStyle = '#AAA';
            ctx.lineWidth = Math.max(2 * objScale, 1);
            ctx.lineCap = 'round';
            scenery.forEach(function (line) {
                ctx.beginPath();
                ctx.moveTo(line.x1 * objScale + centerX, line.y1 * objScale + centerY);
                ctx.lineTo(line.x2 * objScale + centerX, line.y2 * objScale + centerY);
                ctx.stroke();
            });

            ctx.strokeStyle = '#000';
            ctx.lineWidth = Math.max(2 * objScale, 1);
            physics.forEach(function (line) {
                ctx.beginPath();
                ctx.moveTo(line.x1 * objScale + centerX, line.y1 * objScale + centerY);
                ctx.lineTo(line.x2 * objScale + centerX, line.y2 * objScale + centerY);
                ctx.stroke();
            });

            powerups.forEach(function (p) {
                drawPowerup(ctx, p, objScale, centerX, centerY, objScale);
            });
        }

        function drawPatternPreview(data, brushType) {
            var canvas = document.getElementById('pattern-preview-canvas');
            if (!canvas || !data) return;

            updatePatternPreviewWrapper(brushType);

            var wrapper = canvas.parentElement;
            var displaySize = Math.min(wrapper.clientWidth || 150, wrapper.clientHeight || 150);

            var dpr = window.devicePixelRatio || 1;

            canvas.width = displaySize * dpr;
            canvas.height = displaySize * dpr;
            canvas.style.width = displaySize + 'px';
            canvas.style.height = displaySize + 'px';

            var ctx = canvas.getContext('2d');
            ctx.scale(dpr, dpr);

            ctx.fillStyle = '#FFF';
            ctx.fillRect(0, 0, displaySize, displaySize);

            var brushSize = data.brushSize || 100;
            var patternW = data.width;
            var patternH = data.height;
            var physics = data.physics || [];
            var scenery = data.scenery || [];

            if (physics.length === 0 && scenery.length === 0) {
                ctx.fillStyle = '#999';
                ctx.font = '12px sans-serif';
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';
                ctx.fillText('No preview', displaySize / 2, displaySize / 2);
                return;
            }

            var scale = (displaySize - 10) / (brushSize * 2);
            scale = Math.min(scale, 4);
            scale = Math.max(scale, 0.05);

            var scaledBrushSize = brushSize * scale;
            var scaledPatternW = patternW * scale;
            var scaledPatternH = patternH * scale;

            var centerX = displaySize / 2;
            var centerY = displaySize / 2;

            ctx.save();
            ctx.beginPath();
            if (brushType === 0) {
                ctx.rect(
                    centerX - scaledBrushSize,
                    centerY - scaledBrushSize,
                    scaledBrushSize * 2,
                    scaledBrushSize * 2
                );
            } else {
                ctx.arc(centerX, centerY, scaledBrushSize, 0, Math.PI * 2);
            }
            ctx.clip();

            // calculate how many tiles we need to draw
            var tilesX = Math.ceil(scaledBrushSize / scaledPatternW) + 2;
            var tilesY = Math.ceil(scaledBrushSize / scaledPatternH) + 2;

            ctx.lineCap = 'round';
            ctx.lineWidth = Math.max(2 * scale, 1);

            // offset by half pattern size so center shows where 4 tiles meet
            var baseOffsetX = centerX - scaledPatternW / 2;
            var baseOffsetY = centerY - scaledPatternH / 2;

            for (var tx = -tilesX; tx <= tilesX; tx++) {
                for (var ty = -tilesY; ty <= tilesY; ty++) {
                    var offsetX = baseOffsetX + tx * scaledPatternW;
                    var offsetY = baseOffsetY + ty * scaledPatternH;

                    ctx.strokeStyle = '#AAA';
                    ctx.beginPath();
                    scenery.forEach(function (line) {
                        ctx.moveTo(offsetX + line.x1 * scale, offsetY + line.y1 * scale);
                        ctx.lineTo(offsetX + line.x2 * scale, offsetY + line.y2 * scale);
                    });
                    ctx.stroke();

                    ctx.strokeStyle = '#000';
                    ctx.beginPath();
                    physics.forEach(function (line) {
                        ctx.moveTo(offsetX + line.x1 * scale, offsetY + line.y1 * scale);
                        ctx.lineTo(offsetX + line.x2 * scale, offsetY + line.y2 * scale);
                    });
                    ctx.stroke();
                }
            }

            ctx.restore();

            ctx.strokeStyle = '#000';
            ctx.lineWidth = 1;
            ctx.beginPath();
            if (brushType === 0) {
                ctx.rect(
                    centerX - scaledBrushSize,
                    centerY - scaledBrushSize,
                    scaledBrushSize * 2,
                    scaledBrushSize * 2
                );
            } else {
                ctx.arc(centerX, centerY, scaledBrushSize, 0, Math.PI * 2);
            }
            ctx.stroke();
        }

        function drawPowerup(ctx, p, scale, centerX, centerY, objScale) {
            var x = p.x * objScale + centerX;
            var y = p.y * objScale + centerY;

            var size;
            switch (p.name) {
                case 'goal':
                case 'slowmo':
                case 'checkpoint':
                    size = 13 * scale;
                    break;
                case 'bomb':
                    size = 10 * scale;
                    break;
                case 'gravity':
                case 'boost':
                case 'antigravity':
                case 'teleport':
                    size = Math.sqrt(1000) * 0.5 * scale;
                    break;
                case 'helicopter':
                case 'truck':
                case 'balloon':
                case 'blob':
                    size = 15 * scale;
                    break;
                default:
                    size = 10 * scale;
            }

            size = Math.max(size, 3);

            ctx.globalAlpha = 0.5;
            ctx.fillStyle = getPowerupColor(p.name);
            ctx.beginPath();
            ctx.arc(x, y, size, 0, Math.PI * 2);
            ctx.fill();

            if (p.name === 'teleport' && p.x2 !== undefined && p.y2 !== undefined) {
                var x2 = p.x2 * objScale + centerX;
                var y2 = p.y2 * objScale + centerY;
                ctx.beginPath();
                ctx.arc(x2, y2, size, 0, Math.PI * 2);
                ctx.fill();
            }

            ctx.globalAlpha = 1;
        }

        function getPowerupColor(name) {
            var colors = {
                'goal': '#fae335',
                'bomb': '#d12929',
                'gravity': '#376eb7',
                'boost': '#8ac932',
                'slowmo': '#733',
                'checkpoint': '#826cdc',
                'antigravity': '#09faf3',
                'teleport': '#dd45ec',
                'helicopter': '#f2902e',
                'truck': '#94d44e',
                'balloon': '#f02728',
                'blob': '#a784c5'
            };
            return colors[name] || '#888';
        }

