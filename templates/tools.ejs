        function buildFilterParams() {
            if (!filterContext) return '';

            var params = new URLSearchParams();
            params.set('sort', 'shuffle');
            params.set('perPage', '1');

            if (filterContext.type && filterContext.type !== 'db') {
                params.set('type', filterContext.type);
            } else {
                params.set('type', 'db');
            }

            if (filterContext.player) {
                params.set('author', filterContext.player);
            }

            if (filterContext.query) {
                params.set('q', filterContext.query);
            }

            return params.toString();
        }

        document.getElementById('np-prev').addEventListener('click', function () {
            if (playlistContext && playlistContext.tracks && playlistContext.tracks.length > 0) {
                if (playlistContext.currentIndex > 0) {
                    var prevTrack = playlistContext.tracks[playlistContext.currentIndex - 1];
                    var type, id;

                    if (prevTrack.canonical || prevTrack.type === 't') {
                        type = 't';
                        id = prevTrack.canonical || prevTrack.id;
                    } else {
                        type = prevTrack.urlType || prevTrack.type || 'frhd';
                        id = prevTrack.urlId || prevTrack.id;
                    }

                    sendLoadTrack(type, id);
                }
            } else if (!filterContext && currentTrackData) {
                fetchAdjacentTrack('prev');
            }
        });

        document.getElementById('np-next').addEventListener('click', function () {
            if (playlistContext && playlistContext.tracks && playlistContext.tracks.length > 0) {
                if (playlistContext.currentIndex < playlistContext.tracks.length - 1) {
                    var nextTrack = playlistContext.tracks[playlistContext.currentIndex + 1];
                    var type, id;

                    if (nextTrack.canonical || nextTrack.type === 't') {
                        type = 't';
                        id = nextTrack.canonical || nextTrack.id;
                    } else {
                        type = nextTrack.urlType || nextTrack.type || 'frhd';
                        id = nextTrack.urlId || nextTrack.id;
                    }

                    sendLoadTrack(type, id);
                }
            } else if (!filterContext && currentTrackData) {
                fetchAdjacentTrack('next');
            }
        });

        document.getElementById('np-random').addEventListener('click', function () {
            if (playlistContext && playlistContext.tracks.length > 1) {
                var availableIndices = [];
                for (var i = 0; i < playlistContext.tracks.length; i++) {
                    if (i !== playlistContext.currentIndex) {
                        availableIndices.push(i);
                    }
                }
                var randomIdx = availableIndices[Math.floor(Math.random() * availableIndices.length)];
                var randomTrack = playlistContext.tracks[randomIdx];
                var type, id;

                if (randomTrack.canonical) {
                    type = 't';
                    id = randomTrack.canonical;
                } else {
                    type = randomTrack.urlType || randomTrack.type || 'frhd';
                    id = randomTrack.urlId || randomTrack.id;
                }

                sendLoadTrack(type, id);
            } else if (filterContext) {
                if (filterContext.remixesOf) {
                    fetch('/api/remixes/' + encodeURIComponent(filterContext.remixesOf.canonical))
                        .then(function (r) { return r.json(); })
                        .then(function (data) {
                            var remixes = data.remixes || [];
                            if (remixes.length > 0) {
                                var track = remixes[Math.floor(Math.random() * remixes.length)];
                                var type = track.canonical ? 't' : (track.urlType || track.type || 'frhd');
                                var id = track.canonical || track.urlId || track.id;
                                sendLoadTrack(type, id);
                            }
                        })
                        .catch(function (e) { console.error('Failed to get random remix:', e); });
                } else {
                    var params = buildFilterParams();
                    fetch('/api/db?' + params)
                        .then(function (r) { return r.json(); })
                        .then(function (data) {
                            if (data.tracks && data.tracks.length > 0) {
                                var track = data.tracks[0];
                                var type, id;

                                if (track.canonical) {
                                    type = 't';
                                    id = track.canonical;
                                } else {
                                    type = track.urlType || track.type || 'frhd';
                                    id = track.urlId || track.id;
                                }

                                sendLoadTrack(type, id);
                            }
                        })
                        .catch(function (e) {
                            console.error('Failed to get random track:', e);
                        });
                }
            } else {
                fetchRandomTrack();
            }
        });

        function fetchRandomTrack() {
            var params = new URLSearchParams();
            params.set('type', 'db');
            params.set('sort', 'shuffle');
            params.set('perPage', '1');

            if (currentTrackData) {
                var currentCanonical = currentTrackData.canonical || currentTrackData.canonicalId || currentTrackData.id;
                if (currentCanonical) {
                    params.set('exclude', currentCanonical);
                }
            }

            fetch('/api/db?' + params)
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    if (data.tracks && data.tracks.length > 0) {
                        var track = data.tracks[0];
                        var type = track.canonical ? 't' : (track.urlType || track.type || 'frhd');
                        var id = track.canonical || track.urlId || track.id;
                        sendLoadTrack(type, id);
                    }
                })
                .catch(function (e) {
                    console.error('Failed to get random track:', e);
                });
        }

        function sendLoadTrack(type, id) {
            var data = { type: type, id: id };
            if (playlistContext) data.playlist = playlistContext;
            else if (filterContext) data.filterContext = filterContext;
            send('load-track', data);
        }
        function fetchAdjacentTrack(direction) {
            if (!currentTrackData) return;

            var currentCanonical = currentTrackData.canonical || currentTrackData.canonicalId || currentTrackData.id;

            var params = new URLSearchParams();
            params.set('type', 'db');
            params.set('sort', 'published');
            params.set('order', 'asc');
            params.set('perPage', '1');

            if (direction === 'prev') {
                params.set('beforeCanonical', currentCanonical);
            } else {
                params.set('afterCanonical', currentCanonical);
            }

            fetch('/api/db?' + params)
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    if (data.tracks && data.tracks.length > 0) {
                        var track = data.tracks[0];
                        var type = track.canonical ? 't' : (track.urlType || track.type || 'frhd');
                        var id = track.canonical || track.urlId || track.id;
                        sendLoadTrack(type, id);
                    } else {
                        console.log('No more tracks in ' + direction + ' direction');
                    }
                })
                .catch(function (e) {
                    console.error('Failed to get adjacent track:', e);
                });
        }

        function checkAdjacentTracks() {
            if (!currentTrackData) {
                document.getElementById('np-prev').disabled = true;
                document.getElementById('np-next').disabled = true;
                document.getElementById('np-prev').style.borderRight = '8px solid #aaa';
                document.getElementById('np-next').style.borderLeft = '8px solid #aaa';
                return;
            }

            var currentCanonical = currentTrackData.canonical || currentTrackData.canonicalId || currentTrackData.id;

            var prevParams = new URLSearchParams();
            prevParams.set('type', 'db');
            prevParams.set('sort', 'published');
            prevParams.set('order', 'asc');
            prevParams.set('perPage', '1');
            prevParams.set('beforeCanonical', currentCanonical);

            fetch('/api/db?' + prevParams)
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    var hasPrev = data.tracks && data.tracks.length > 0;
                    document.getElementById('np-prev').disabled = !hasPrev;
                    document.getElementById('np-prev').style.opacity = hasPrev ? '1' : '0.5';
                });

            var nextParams = new URLSearchParams();
            nextParams.set('type', 'db');
            nextParams.set('sort', 'published');
            nextParams.set('order', 'asc');
            nextParams.set('perPage', '1');
            nextParams.set('afterCanonical', currentCanonical);

            fetch('/api/db?' + nextParams)
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    var hasNext = data.tracks && data.tracks.length > 0;
                    document.getElementById('np-next').disabled = !hasNext;
                    document.getElementById('np-next').style.opacity = hasNext ? '1' : '0.5';
                });
        }

