        function updateTabIcons(s) {
            var toolIcon = document.querySelector('.tab-button[data-tab="tool"] .tab-icon');
            if (toolIcon && s.currentTool) {
                var toolIconClass = 'editorgui_icons editorgui_icons-icon_';
                switch (s.currentTool) {
                    case 'brush': toolIconClass += 'brush'; break;
                    case 'straightline': toolIconClass += 'line'; break;
