        function updateNowPlaying(track) {
            currentTrackData = track;

            var emptyEl = document.getElementById('now-playing-empty');
            var contentEl = document.getElementById('now-playing-content');

            if (!track || !track.name) {
                emptyEl.style.display = 'block';
                contentEl.style.display = 'none';
                return;
            }

            emptyEl.style.display = 'none';
            contentEl.style.display = 'block';

            document.getElementById('np-thumbnail').src = track.thumbnail || '/' + track.type + '/' + track.id + '.png';

            var badges = track.badges || [track.type];
            var uniqueBadges = [];
            var seen = {};
            for (var i = 0; i < badges.length; i++) {
                if (!seen[badges[i]]) {
                    seen[badges[i]] = true;
                    uniqueBadges.push(badges[i]);
                }
            }

            document.getElementById('np-badges').innerHTML = uniqueBadges.map(function (b) {
                return '<span class="track-type-badge ' + b + '">' + getBadgeText(b) + '</span>';
            }).join('');

            document.getElementById('np-name').textContent = track.name;

            document.getElementById('np-name').textContent = track.name;

            var authorLine = document.getElementById('np-author-line');
            var avatarsContainer = document.getElementById('np-author-avatars');
            var authors = track.authors || 'Unknown';
            var authorParts = authors.split(/,\s*/);

            var authorHtml = 'by ' + authorParts.map(function (author) {
                return '<a href="#" class="np-author-link" data-author="' + author.trim() + '" style="color: #1884cf; text-decoration: none; font-weight: bold;">' + author.trim() + '</a>';
            }).join(', ');

            authorLine.innerHTML = authorHtml;

            avatarsContainer.innerHTML = authorParts.map(function (author) {
                return '<img class="np-author-avatar" data-author="' + author.trim() + '" src="" alt="" title="' + author.trim() + '" style="display:none;">';
            }).join('');

            authorParts.forEach(function (author) {
                var authorName = author.trim();
                fetchAuthorAvatar(authorName, function (avatarUrl) {
                    if (avatarUrl) {
                        var avatarImg = avatarsContainer.querySelector('.np-author-avatar[data-author="' + authorName + '"]');
                        if (avatarImg) {
                            avatarImg.src = avatarUrl;
                            avatarImg.style.display = '';
                            avatarImg.onerror = function () { this.style.display = 'none'; };
                        }
                    }
                });
            });

            var descEl = document.getElementById('np-description');
            if (track.description && track.description.trim()) {
                descEl.textContent = track.description;
                descEl.style.display = 'block';
            } else {
                descEl.style.display = 'none';
            }

            setNpRow('id', track.id);
            setNpRowPublished(track.published);
            setNpRow('size', formatSize(track.size));
            setNpRow('plays', track.plays);

            var votesRow = document.getElementById('np-row-votes');
            var votesEl = document.getElementById('np-votes');
            if (track.upvotes || track.votes) {
                votesEl.textContent = track.downvotes ? '+' + track.upvotes + ' / -' + track.downvotes : (track.upvotes || track.votes);
                votesRow.style.display = '';
            } else {
                votesRow.style.display = 'none';
            }

            var remixOfRow = document.getElementById('np-row-remix-of');
            var remixOfEl = document.getElementById('np-remix-of');
            if (remixOfRow && remixOfEl) {
                if (track.remixOf && track.remixOf.length > 0) {
                    var remixLinks = track.remixOf.map(function (r) {
                        return '<a href="#" class="np-track-link" data-type="t" data-id="' + r.canonical + '" data-no-context="true" style="color: #1884cf; text-decoration: none;">' + r.name + '</a>';
                    }).join(', ');
                    remixOfEl.innerHTML = remixLinks;
                    remixOfRow.style.display = '';
                } else {
                    remixOfRow.style.display = 'none';
                }
            }

            var remixesRow = document.getElementById('np-row-remixes');
            var remixesEl = document.getElementById('np-remixes');
            if (remixesRow && remixesEl) {
                if (track.remixCount && track.remixCount > 0) {
                    var trackName = track.name || track.id;
                    var trackCanonical = track.canonical || track.id;
                    remixesEl.innerHTML = '<a href="#" class="np-remixes-link" data-canonical="' + trackCanonical + '" data-name="' + trackName.replace(/"/g, '&quot;') + '" style="color: #1884cf; text-decoration: none;">' + track.remixCount + ' remix' + (track.remixCount > 1 ? 'es' : '') + '</a>';
                    remixesRow.style.display = '';
                } else {
                    remixesRow.style.display = 'none';
                }
            }

            var entryToRow = document.getElementById('np-row-entry-to');
            var entryToEl = document.getElementById('np-entry-to');
            if (entryToRow && entryToEl) {
                if (track.entryTo) {
                    entryToEl.innerHTML = '<a href="#" class="np-playlist-link" data-playlist-id="' + (track.entryTo.canonical) + '" style="color: #1884cf; text-decoration: none;">' + track.entryTo.name + '</a>';
                    entryToRow.style.display = '';
                } else {
                    entryToRow.style.display = 'none';
                }
            }

            setNpRowLink('frhd-id', track.frhdId, 'frhd');
            setNpRowLink('bhr-id', track.bhrId, 'bhr');
            setNpRowLink('cr-id', track.crId, 'cr');
            setNpRowLink('tm-id', track.tmId, 'tm');

            if (!playlistContext && !filterContext && track) {
                checkAdjacentTracks();
            }
        }

        function getBadgeText(type) {
            var map = { bhr: 'BHR', cr: 'CR', frhd: 'FRHD', fr: 'FR', tm: 'TM', app: 'APP' };
            return map[type] || type.toUpperCase();
        }

        function setNpRowPublished(dateStr) {
            var row = document.getElementById('np-row-published');
            var cell = document.getElementById('np-published');

            if (!dateStr) {
                row.style.display = 'none';
                return;
            }

            var formatted = formatDate(dateStr);
            if (!formatted) {
                row.style.display = 'none';
                return;
            }

            var year = formatted.substring(0, 4);
            var rest = formatted.substring(4);

            cell.innerHTML = '<a href="#" class="np-year-link" data-year="' + year + '" style="color: #1884cf; text-decoration: none;">' + year + '</a>' + rest;
            row.style.display = '';
        }

        function formatDate(dateStr) {
            if (!dateStr) return null;
            if (dateStr.includes('T')) return dateStr.split('T')[0];
            if (dateStr.includes(' ')) return dateStr.split(' ')[0];
            return dateStr;
        }

        function formatSize(bytes) {
            if (bytes === null || bytes === undefined || bytes === 0 || isNaN(bytes)) { return ''; }
            const k = 1024;
            const sizes = ['b', 'k', 'm', 'gb', 'tb'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + sizes[i];
        }

        function setNpRowLink(field, value, type) {
            var row = document.getElementById('np-row-' + field);
            var cell = document.getElementById('np-' + field);
            if (row && cell) {
                if (value && type === 'frhd') {
                    cell.innerHTML = '<a href="https://freeriderhd.com/t/' + value + '" target="_blank" rel="nooperner noreferrer" class="np-external-link" data-type="' + type + '" data-id="' + value + '" style="color: #1884cf; text-decoration: none;">' + value + '</span>';
                    row.style.display = '';
                } else if (value && type === 'cr') {
                    cell.innerHTML = '<a href="https://canvasrider.com/tracks/' + value + '" target="_blank" rel="nooperner noreferrer" class="np-external-link" data-type="' + type + '" data-id="' + value + '" style="color: #1884cf; text-decoration: none;">' + value + '</span>';
                    row.style.display = '';
                } else if (value && (type !== 'frhd' || type !== 'cr')) {
                    cell.innerHTML = '<span class="np-external-link" data-type="' + type + '" data-id="' + value + '" style="color: #1884cf; text-decoration: none;">' + value + '</span>';
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            }
        }

