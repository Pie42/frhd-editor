<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <title>Tool Options</title>
    <link rel="stylesheet" type="text/css" href="/app.css">
</head>

<body style="margin: 0; padding: 0;">
    <div class="editorDialog-tools editorDialog-content_brushDialog"
        style="background: transparent; box-shadow: none; width: 100%; max-width: none; margin: 0; border-radius: 0; height: 100dvh; overflow-y:scroll;">

        <div id="toolbox-content">
            
        <!-- TAB NAVIGATION -->
        <div class="tab-container">
            <button class="tab-button active" data-tab="tool">
                <span class="tab-icon editorgui_icons editorgui_icons-icon_camera" style="transform: scale(0.5)"></span>
                <span class="tab-label">Tool</span>
            </button>
            <button class="tab-button" data-tab="grid">
                <span class="tab-icon editorgui_icons editorgui_icons-icon_grid_on"
                    style="transform: scale(0.5)"></span>
                <span class="tab-label">Grid</span>
            </button>
            <button class="tab-button" data-tab="snap">
                <span class="tab-icon editorgui_icons editorgui_icons-icon_snap_on"
                    style="transform: scale(0.5) translate(1px,0px);"></span>
                <span class="tab-label">Snap</span>
            </button>
            <button class="tab-button" data-tab="object">
                <span class="tab-icon cube" style="transform: scale(0.325) translate(0px,2px);"></span>
                <span class="tab-label">Object</span>
            </button>
            <button class="tab-button" data-tab="layer">
                <span class="tab-icon editorgui_icons editorgui_icons-icon_all"
                    style="transform: scale(0.35) translate(0px,2px);"></span>
                <span class="tab-label">Layer</span>
            </button>
            <!--<button class="tab-button" data-tab="vehicle" style="display: none">
                <span class="tab-icon editorgui_icons_bottom_vehicle editorgui_icons-icon_bmx"
                    style="transform: scale(0.6) translate(0px,1px);"></span>
                <span class="tab-label">Vehicle</span>
            </button>-->
            <button class="tab-button" data-tab="vehicle">
                <span class="tab-icon editorgui_icons_bottom_vehicle editorgui_icons-icon_bmx"
                    style="transform: scale(0.5) translate(0px,1px);"></span>
                <span class="tab-label">Track</span>
            </button>
            <button class="tab-button" data-tab="mods">
                <span class="tab-icon" style="display: inline-block; transform: scale(0.7) translate(0px,1px);">
                    <svg width="20" height="20" viewBox="0 0 32 32" style="transform: translateY(2px);">
                        <polygon points="16,4 27.4,12.3 23.1,25.7 8.9,25.7 4.6,12.3" fill="none" stroke="#000"
                            stroke-width="8" stroke-linejoin="round" />
                        <polygon points="16,4 27.4,12.3 23.1,25.7 8.9,25.7 4.6,12.3" fill="none" stroke="#fff"
                            stroke-width="4" stroke-linejoin="round" class="pentagon-inner" />
                    </svg>
                </span>
                <span class="tab-label">Mods</span>
            </button>
        </div>

        <!-- TOOL TAB CONTENT -->
        <div id="tab-tool" class="tab-content active">
            <!-- STRAIGHTLINE OPTIONS -->
            <div id="section-straightline" class="tool-section" style="display: none;">
                <div class="editorDialog-toolsTitleBar">
                    <h1 class="editorDialog-content-title">LINE OPTIONS</h1>
                    <span class="line-type-badge mode-badge physics">PHYSICS</span>
                </div>
                <div class="description">
                    <span style="color: #888;">
                        <p>Click and drag to draw the start and endpoints of a straight line.
                            <br><br>
                            Press <b>TAB</b> to toggle between physics and scenery line types, or press the line type
                            icons on the right menu.
                            <br><br>
                            Press the object icon on the right menu to enable object line type.
                            <br><br>
                            Press <b>G</b> or press the grid icon to enable grid mode.
                            <br><br>
                            Hold <b>ALT</b> or press the snap icon to enable line snap.
                            <br><br>
                            Hold <b>CTRL</b> to see the angle and length of your line while drawing.
                            <br><br>
                            Hold <b>CTRL</b> + <b>Shift</b> to angle lines in 15 degree increments.
                        </p>
                    </span>
                </div>
                <div class="toolsDialogAdvanced" style="padding: 15px;">
                </div>
            </div>

            <!-- CURVE OPTIONS -->
            <div id="section-curve" class="tool-section" style="display: none;">
                <div class="editorDialog-toolsTitleBar">
                    <h1 class="editorDialog-content-title">CURVE OPTIONS</h1>
                    <span class="line-type-badge mode-badge physics">PHYSICS</span>
                </div>
                <div class="description">
                    <span style="color: #888;">
                        <p>Click and drag to draw the start and endpoint of the curve, and click again to set the shape
                            of the curve.
                            <br><br>
                            Hold <b>Shift</b> and use the mouse wheel to change the segment length.
                            <br><br>
                            Hold <b>CTRL</b> + <b>Shift</b> to angle lines in 15 degree increments.
                        </p>
                    </span>
                </div>
                <div class="toolsDialogAdvanced" style="padding: 15px;">
                    <table>
                        <tbody>
                            <tr>
                                <td class="settingName"><span class="name">Segment Length</span></td>
                                <td>
                                    <div class="horizontal-slider-container-2">
                                        <input type="range" id="curve-segmentLength" class="horizontal-slider-2" min="1"
                                            max="10" step="1" value="4">
                                        <input type="text" class="toolSettings-input" id="val-curve-segmentLength"
                                            value="0.4" readonly>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- CIRCLE OPTIONS -->
            <div id="section-circle" class="tool-section" style="display: none;">
                <div class="editorDialog-toolsTitleBar">
                    <h1 class="editorDialog-content-title">CIRCLE OPTIONS</h1>
                    <span class="line-type-badge mode-badge physics">PHYSICS</span>
                </div>
                <div class="description">
                    <span style="color: #888;">
                        <p>Click and drag to draw circles. For ellipses, click and drag to draw the shape of the
                            ellipse, and then click again to set the rotation of the ellipse.
                            <br><br>
                            Hold <b>Shift</b> and use the mouse wheel to change the segment length.
                            <br><br>
                            Hold <b>CTRL</b> + <b>Shift</b> to angle in 15 degree increments.
                        </p>
                    </span>
                </div>
                <div class="toolsDialogAdvanced" style="padding: 15px;">
                    <table>
                        <tbody>
                            <tr>
                                <td class="settingName"><span class="name">Segment Length</span></td>
                                <td>
                                    <div class="horizontal-slider-container-2">
                                        <input type="range" id="circle-segmentLength" class="horizontal-slider-2"
                                            min="0.1" max="2" step="0.1" value="0.4">
                                        <input type="text" class="toolSettings-input" id="val-circle-segmentLength"
                                            value="0.4" readonly>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td class="settingName"><span class="name">Circle Type</span></td>
                                <td class="settingInput"><button id="btn-ellipse"
                                        onclick="toggleEllipse()">Ellipse</button></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- BRUSH OPTIONS -->
            <div id="section-brush" class="tool-section" style="display: none;">
                <div class="editorDialog-toolsTitleBar">
                    <h1 class="editorDialog-content-title">BRUSH OPTIONS</h1>
                    <span class="line-type-badge mode-badge physics">PHYSICS</span>
                </div>
                <div class="description">
                    <span style="color: #888;">
                        <p>Click and drag to draw lines rapidly following your cursor.
                            <br><br>
                            <i>Break Length</i> determines how long the line will be before being placed.
                            <br><br>
                            <i>Trail Speed</i> determines how quickly the lines follow the cursor.
                            <br><br>
                            Press <b>CTRL</b> + <b>Z</b> / <b>CTRL</b> + <b>Y</b> to undo/redo brush lines one at a
                            time, or press <b>CTRL</b> + <b>Shift</b> + <b>Z</b> / <b>CTRL</b> + <b>Shift</b> + <b>Y</b>
                            to undo/redo your full brush stroke. Pressing <b>Shift</b> and the undo/redo icons works the
                            same way.
                        </p>
                    </span>
                </div>
                <div class="toolsDialogAdvanced" style="padding: 15px;">
                    <table>
                        <tbody>
                            <tr>
                                <td class="settingName"><span class="name">Break Length</span></td>
                                <td>
                                    <div class="horizontal-slider-container-2">
                                        <input type="range" id="brush-breakLength" class="horizontal-slider-2"
                                            min="0.049" max="10.049" step="0.1" value="1">
                                        <input type="text" class="toolSettings-input" id="val-brush-breakLength"
                                            value="1.0" readonly>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td class="settingName"><span class="name">Trail Speed</span></td>
                                <td>
                                    <div class="horizontal-slider-container-2">
                                        <input type="range" id="brush-trailSpeed" class="horizontal-slider-2"
                                            min="0.049" max="1.049" step="0.1" value="0.5">
                                        <input type="text" class="toolSettings-input" id="val-brush-trailSpeed"
                                            value="0.5" readonly>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- PATTERN OPTIONS -->
            <div id="section-pattern" class="tool-section" style="display: none;">
                <div class="editorDialog-toolsTitleBar">
                    <h1 class="editorDialog-content-title">PATTERN BRUSH OPTIONS</h1>
                    <span class="line-type-badge mode-badge physics">PHYSICS</span>
                </div>
                <div class="description">
                    <span style="color: #888;">
                        <p>Click and drag the pattern brush over an area to fill it with a tiling object pattern.
                            <br><br>
                            Use the <i>Brush Size</i> slider to change the size of the brush.
                            <br><br>
                            <i>Global Grid</i> aligns the pattern to a fixed grid, while disabling it centers the
                            pattern on your cursor.
                        </p>
                    </span>
                </div>
                <div class="toolsDialogAdvanced" style="padding: 15px; display: block;">
                    <!--<h3 style="margin: 15px 0 10px 0; font-size: 12px;">PATTERNS</h3>-->
                    <div style="margin-bottom: 10px;">
                        <button id="btn-pattern-from-db" class="tool-button">+ Import Pattern</button>
                        <button id="btn-pattern-from-object" class="tool-button">+ Create from Current Object</button>
                    </div>
                    <div id="pattern-list" class="object-list">
                        <!-- Patterns will be populated here -->
                    </div>
                    <div id="pattern-details" style="margin-top: 15px; display: none;">
                        <div id="pattern-thumbnail-container" style="text-align: center; padding: 10px;">
                            <div class="object-preview-wrapper">
                                <canvas id="pattern-preview-canvas"></canvas>
                            </div>
                            <div id="pattern-name-display" style="font-weight: bold; padding: 15px;">No pattern selected
                            </div>
                        </div>
                    </div>
                    <table>
                        <tbody>
                            <tr>
                                <td class="settingName"><span class="name">Brush Size</span></td>
                                <td>
                                    <div class="horizontal-slider-container-2">
                                        <input type="range" id="pattern-brushSize" class="horizontal-slider-2" min="10"
                                            max="500" step="10" value="100">
                                        <input type="text" class="toolSettings-input" id="val-pattern-brushSize"
                                            value="100" readonly>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td class="settingName"><span class="name">Brush Shape</span></td>
                                <td class="settingInput">
                                    <select id="pattern-brush" class="tool-select">
                                        <option value="0">Rectangle</option>
                                        <option value="1" selected>Circle</option>
                                    </select>
                                </td>
                            </tr>
                            <tr>
                                <td class="settingName"><span class="name">Global Grid</span></td>
                                <td class="settingInput"><input type="checkbox" id="pattern-globalGrid" checked></td>
                            </tr>
                            <tr>
                                <td class="settingName"><span class="name">Experimental Speedups</span></td>
                                <td class="settingInput"><input type="checkbox" id="pattern-experimentalSpeedups"></td>
                            </tr>
                            <tr>
                                <td class="settingName"><span class="name">Experimental Stabilization</span></td>
                                <td class="settingInput"><input type="checkbox" id="pattern-experimentalStabilization">
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- ERASER OPTIONS -->
            <div id="section-eraser" class="tool-section" style="display: none;">
                <div class="editorDialog-toolsTitleBar">
                    <h1 class="editorDialog-content-title">ERASER OPTIONS</h1>
                </div>
                <div class="description">
                    <span style="color: #888;">
                        <p>Click and drag to erase lines within the eraser radius.
                            <br><br>
                            Hold <b>Shift</b> and use the mouse wheel to change eraser radius.
                            <br><br>
                            <i>Line Erase</i> will erase entire lines that intersect with the eraser.
                            <br><br>
                            <i>Line Trim</i> will only erase the section of the line that overlaps with the eraser.
                        </p>
                    </span>
                </div>
                <div class="toolsDialogAdvanced" style="padding: 15px;">
                    <table>
                        <tbody>
                            <tr>
                                <td class="settingName"><span class="name">Radius</span></td>
                                <td>
                                    <div class="horizontal-slider-container-2">
                                        <input type="range" id="eraser-radius" class="horizontal-slider-2" min="1"
                                            max="200" step="1" value="40">
                                        <input type="text" class="toolSettings-input" id="val-eraser-radius" value="40"
                                            readonly>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td class="settingName"><span class="name">Eraser Type</span></td>
                                <td class="settingInput"><button id="btn-lineTrim" onclick="toggleLineTrim()">Line
                                        Erase</button></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- POWERUP OPTIONS -->
            <div id="section-powerup" class="tool-section" style="display: none;">
                <div class="editorDialog-toolsTitleBar">
                    <h1 class="editorDialog-content-title">POWERUP OPTIONS</h1>
                    <span id="powerup-selected" class="powerup-badge mode-badge"
                        style="background: #fae335;">GOAL</span>
                </div>

                <!-- GOAL -->
                <div id="powerup-goal" class="powerup-section" style="display: none;">
                    <div class="description">
                        <span style="color: #888;">
                            <p>Click to place a <b>Goal</b> for the rider to collect to complete the track.
                            </p>
                        </span>
                    </div>
                    <div class="toolsDialogAdvanced" style="padding: 15px;">
                    </div>
                </div>

                <!-- BOOST -->
                <div id="powerup-boost" class="powerup-section" style="display: none;">
                    <div class="description">
                        <span style="color: #888;">
                            <p>Click to place <b>Boost</b> powerups that give the rider a speed boost. Click and drag to
                                set the boost direction.
                                <br><br>
                                The boost direction is indicated by the arrow. While placing the powerup, hold
                                <b>CTRL</b> to show the angle in degrees, and hold <b>CTRL</b> + <b>Shift</b> to change
                                the angle in 15 degree increments.
                            </p>
                        </span>
                    </div>
                    <div class="toolsDialogAdvanced" style="padding: 15px;">
                    </div>
                </div>

                <!-- GRAVITY -->
                <div id="powerup-gravity" class="powerup-section" style="display: none;">
                    <div class="description">
                        <span style="color: #888;">
                            <p>Click to place <b>Gravity</b> powerups that change the direction of gravity. Click and
                                drag to set the gravity direction.
                                <br><br>
                                The gravity direction is indicated by the arrow. While placing the powerup, hold
                                <b>CTRL</b> to show the angle in degrees, and hold <b>CTRL</b> + <b>Shift</b> to change
                                the angle in 15 degree increments.
                            </p>
                        </span>
                    </div>
                    <div class="toolsDialogAdvanced" style="padding: 15px;">
                    </div>
                </div>

                <!-- SLOWMO -->
                <div id="powerup-slowmo" class="powerup-section" style="display: none;">
                    <div class="description">
                        <span style="color: #888;">
                            <p>Click to place <b>Slow Motion</b> powerups that slow down time by 50% for the rider.
                                <br><br>
                                The effect lasts until the rider touches both wheels to physics lines simultaneously.
                            </p>
                        </span>
                    </div>
                    <div class="toolsDialogAdvanced" style="padding: 15px;">
                    </div>
                </div>

                <!-- BOMB -->
                <div id="powerup-bomb" class="powerup-section" style="display: none;">
                    <div class="description">
                        <span style="color: #888;">
                            <p>Click to place <b>Bomb</b> powerups that explode on contact with the rider.
                            </p>
                        </span>
                    </div>
                    <div class="toolsDialogAdvanced" style="padding: 15px;">
                    </div>
                </div>

                <!-- CHECKPOINT -->
                <div id="powerup-checkpoint" class="powerup-section" style="display: none;">
                    <div class="description">
                        <span style="color: #888;">
                            <p>Click to place <b>Checkpoints</b> that save the rider's progress.
                                <br><br>
                                When the rider restarts, they will respawn at the last checkpoint they hit.
                            </p>
                        </span>
                    </div>
                    <div class="toolsDialogAdvanced" style="padding: 15px;">
                    </div>
                </div>

                <!-- ANTIGRAVITY -->
                <div id="powerup-antigravity" class="powerup-section" style="display: none;">
                    <div class="description">
                        <span style="color: #888;">
                            <p>Click to place <b>Antigravity</b> powerups that turn off gravity for the rider.
                            </p>
                        </span>
                    </div>
                    <div class="toolsDialogAdvanced" style="padding: 15px;">
                    </div>
                </div>

                <!-- TELEPORT -->
                <div id="powerup-teleport" class="powerup-section" style="display: none;">
                    <div class="description">
                        <span style="color: #888;">
                            <p>Click and drag to place matching pairs of <b>Portal</b> powerups that teleport the rider
                                between them.
                                <br><br>
                                The portals can only be used once before becoming inactive.
                            </p>
                        </span>
                    </div>
                    <div class="toolsDialogAdvanced" style="padding: 15px;">
                    </div>
                </div>
            </div>

            <!-- VEHICLE POWERUP OPTIONS -->
            <div id="section-vehiclepowerup" class="tool-section" style="display: none;">
                <div class="editorDialog-toolsTitleBar">
                    <h1 class="editorDialog-content-title">VEHICLE POWERUP OPTIONS</h1>
                    <span id="vehiclepowerup-selected" class="powerup-badge mode-badge"
                        style="background: #f2902e;">HELICOPTER</span>
                </div>
                <div class="description">
                    <span style="color: #888;">
                        <p>Click to place vehicle powerups on the track that temporarily transform the rider into that
                            respective vehicle.
                            <br><br>
                            Use the <i>Vehicle Time</i> slider to change the length of time the rider is transformed.
                        </p>
                    </span>
                </div>
                <div class="toolsDialogAdvanced" style="padding: 15px;">
                    <table>
                        <tbody>
                            <tr>
                                <td class="settingName"><span class="name">Vehicle Time</span></td>
                                <td>
                                    <div class="horizontal-slider-container-2">
                                        <input type="range" id="vehiclepowerup-time" class="horizontal-slider-2" min="1"
                                            max="60" step="1" value="10">
                                        <input type="text" class="toolSettings-input" id="val-vehiclepowerup-time"
                                            value="10" readonly>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- SELECT OPTIONS -->
            <div id="section-select" class="tool-section" style="display: none;">
                <div class="editorDialog-toolsTitleBar">
                    <h1 class="editorDialog-content-title">SELECT OPTIONS</h1>
                </div>
                <div class="description">
                    <span style="color: #888;">
                        <p>Click and drag to select lines and powerups, or select points to change their position.
                            <br><br>
                            Hold <b>ALT</b> to make another select that will be added to your current selection.
                            <br><br>
                            Once selected, you can move, scale, rotate, and flip the selection.
                            <br><br>
                            Hold <b>CTRL</b> and press the directional keys to move the selection by the <i>Offset
                                Factor</i>.
                            Hold <b>Shift</b> to move the cursor relative to your selection and the center point for
                            transformations.
                        </p>
                    </span>
                </div>
                <div class="toolsDialogAdvanced" style="padding: 15px;">
                    <table>
                        <tbody>
                            <tr>
                                <td class="settingName"><span class="name">Rotate Factor</span></td>
                                <td class="settingInput">
                                    <select id="select-rotate-factor" class="tool-select">
                                        <option value="1">1°</option>
                                        <option value="5">5°</option>
                                        <option value="15" selected>15°</option>
                                        <option value="30">30°</option>
                                        <option value="45">45°</option>
                                        <option value="90">90°</option>
                                    </select>
                                </td>
                            </tr>
                            <tr>
                                <td class="settingName"><span class="name">Scale Factor</span></td>
                                <td class="settingInput">
                                    <select id="select-scale-factor" class="tool-select">
                                        <option value="0.05">0.05</option>
                                        <option value="0.1" selected>0.1</option>
                                        <option value="0.25">0.25</option>
                                        <option value="0.5">0.5</option>
                                        <option value="1">1</option>
                                        <option value="2">2</option>
                                        <option value="5">5</option>
                                    </select>
                                </td>
                            </tr>
                            <tr>
                                <td class="settingName"><span class="name">Offset Factor</span></td>
                                <td class="settingInput">
                                    <select id="select-offset-factor" class="tool-select">
                                        <option value="1">1</option>
                                        <option value="2">2</option>
                                        <option value="5">5</option>
                                        <option value="10" selected>10</option>
                                        <option value="20">20</option>
                                        <option value="25">25</option>
                                        <option value="50">50</option>
                                    </select>
                                </td>
                            </tr>
                            <tr>
                                <td class="settingName"><span class="name">Scale Lock</span></td>
                                <td class="settingInput"><input type="checkbox" id="select-scaleLock"></td>
                            </tr>
                            <tr>
                                <td class="settingName"><span class="name">Selection Type</span></td>
                                <td class="settingInput"><button id="btn-copy" onclick="toggleCopy()">CUT +
                                        PASTE</button></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- CAMERA OPTIONS -->
            <div id="section-camera" class="tool-section" style="display: none;">
                <div class="editorDialog-toolsTitleBar">
                    <h1 class="editorDialog-content-title">CAMERA OPTIONS</h1>
                    <span id="camera-lock-toggle"
                        class="toggle-icon editorgui_icons_bottom editorgui_icons-icon_camera_lock_off"
                        style="transform: scale(0.8) translate(0, -4px);" title="Toggle Camera Lock"></span>
                </div>
                <div class="description">
                    <span style="color: #888;">
                        <p>Click and drag to pan the camera view.
                            <br><br>
                            Toggling the <i>Camera Lock</i> icon will stop the canvas from scrolling when drawing near
                            the edges of the screen.
                            <br><br>
                            Use the mousewheel or press the zoom in/out buttons to zoom the camera, and change the
                            <i>Zoom Sensitivity</i> to control the zoom speed.
                            <br><br>
                            <i>Camera Movement</i> settings allow you to restrict the camera to horizontal, vertical, or
                            no movement.
                            <br><br>
                            <i>Camera Speed</i> settings determine how fast the camera follows the rider.
                        </p>
                    </span>
                </div>
                <div class="toolsDialogAdvanced" style="padding: 15px;">
                    <table>
                        <tbody>
                            <tr>
                                <td class="settingName"><span class="name">Zoom Sensitivity</span></td>
                                <td class="settingInput">
                                    <select id="camera-sensitivity" class="tool-select">
