            'trackChanged': function (data) {
                hidePlayerProfile();
                if (!data.ghost) {
                    clearActiveGhost();
                }
                if (data.type && data.id) {
                    loadTrackData(data.type, data.id);
                }
                if (data.ghost) {
                    setActiveGhost(data.ghost);
