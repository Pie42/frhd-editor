            var objInvert = document.getElementById('obj-invert');
            var objectName2 = document.getElementById('object-name-2');

            if (objRotate) objRotate.textContent = (s.objectRotate || 0) + '°';
            if (objScale) objScale.textContent = (s.objectScale || 1).toFixed(2) + 'x';
            if (objOffsetX) objOffsetX.textContent = '(' + (s.objectOffsetX || 0) + ')';
            if (objOffsetY) objOffsetY.textContent = '(' + (s.objectOffsetY || 0) + ')';

            var flipX = s.objectFlipX ? 'X' : '';
            var flipY = s.objectFlipY ? 'Y' : '';
            if (objFlip) objFlip.textContent = (flipX + ' ' + flipY).trim() || 'none';

            var invertText = 'none';
            if (s.objectInvert && s.objectInvertFlat) invertText = 'scenery';
            else if (!s.objectInvert && s.objectInvertFlat) invertText = 'physics';
            else if (s.objectInvert) invertText = 'invert';
            if (objInvert) objInvert.textContent = invertText;

            var btnFlipX = document.getElementById('btn-flip-x');
            var btnFlipY = document.getElementById('btn-flip-y');
            var btnInvert = document.getElementById('btn-invert');
            var btnInvertFlat = document.getElementById('btn-invert-flat');

            if (btnFlipX) btnFlipX.classList.toggle('engaged', !!s.objectFlipX);
            if (btnFlipY) btnFlipY.classList.toggle('engaged', !!s.objectFlipY);
            if (btnInvert) btnInvert.classList.toggle('engaged', !!s.objectInvert);
            if (btnInvertFlat) btnInvertFlat.classList.toggle('engaged', !!s.objectInvertFlat);

            if (objectName2) objectName2.textContent = objectName || 'No object selected';

            if (s.objectPreviewData) {
                drawObjectPreview(s.objectPreviewData);
            }
        }

        function updatePatternSettings(s) {
