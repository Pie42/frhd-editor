<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <title>
        <%= title %> - Free Rider Archive
    </title>
    <link rel="stylesheet" type="text/css" href="/style-black-o.css">
    <link rel="icon" href="/images/favicon.ico" type="image/x-icon">

    <style>
        #content {
            margin: 0 auto;
            max-width: 95vw;
        }

        .sticky-header {
            position: fixed;
            width: 100%;
            top: 0;
            background: #fff;
            z-index: 100;
            padding: 10px 0;
            border-bottom: 1px solid #ddd;
        }

        .controls-row {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px 20px;
            flex-wrap: wrap;
            max-width: 800px;
            margin: 0 auto;
            padding: 0px 10px;
            user-select: none;
            -webkit-user-select: none;
            -moz-user-select: none;
            -ms-user-select: none;
        }

        .type-filters,
        .toggle-group,
        .search-sort-group {
            flex: 0 0 auto;
        }

        .type-filters {
            display: flex;
            gap: 5px;
            font-family: Ubuntu, "Helvetica Neue", Helvetica, Arial, sans-serif;
            letter-spacing: 1px;
        }

        .type-filter-link {
            text-decoration: none;
            cursor: pointer;
        }

        .type-filter-link:hover {
            text-decoration: underline;
        }

        .track-type-filter {
            margin: 5px;
        }

        .toggle-group {
            display: flex;
            align-items: center;
            gap: 0;
        }

        .toggle-label {
            display: flex;
            align-items: center;
            gap: 4px;
            white-space: nowrap;
            cursor: pointer;
        }

        .search-sort-group {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
            justify-content: center;
        }

        .search-input {
            width: 126px;
            height: 18px;
            padding: 2px 8px;
            text-align: center;
        }

        .sort-select {
            width: 140px;
            height: 28px;
            padding: 2px 8px;
            background: #fff;
            border: 1px solid #ccc;
            cursor: pointer;
        }

        .filter-indicator,
        .author-filter-indicator {
            display: flex;
            align-items: center;
            gap: 4px;
            padding: 5px 10px;
            font-size: 12px;
            background: #e8f4fc;
            border: 1px solid #1884cf;
            border-radius: 4px;
        }

        .filter-indicator .clear-filter,
        .author-filter-indicator .clear-filter {
            padding: 0 5px;
            font-weight: bold;
            color: #666;
            cursor: pointer;
        }

        .filter-indicator .clear-filter:hover,
        .author-filter-indicator .clear-filter:hover {
            color: #c00;
        }

        .track-grid {
            -webkit-user-select: none;
            -ms-user-select: none;
            user-select: none;
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            padding: 10px 0;
        }

        .track-item,
        .author-item {
            width: calc(20% - 8px);
            padding: 0;
            margin-bottom: 0;
            box-sizing: border-box;
        }

        .track-thumb,
        .author-thumb {
            width: 100%;
            text-align: center;
        }

        .track-thumb .thumbnail {
            position: relative;
            aspect-ratio: 5 / 3;
            max-width: 250px;
            max-height: 150px;
            margin: 0 auto 5px;
            overflow: hidden;
            border-radius: 4px;
        }

        .track-thumb .thumbnail:hover {
            border: 1px solid #1884cf;
        }

        .track-thumbnail {
            width: 100%;
            height: 100%;
            margin: 0;
            object-fit: cover;
        }

        .track-thumb .desc {
            max-width: 250px;
            height: 28px;
            margin: 0 auto;
            font-size: 12px;
            color: #000;
            overflow: hidden;
            text-overflow: ellipsis;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            line-clamp: 2;
            -webkit-box-orient: vertical;
        }

        .track-thumb .desc strong {
            color: #000;
        }

        .track-thumb .desc .author-link {
            color: #1884cf;
            text-decoration: none;
        }

        .track-thumb .desc .author-link:hover {
            text-decoration: underline;
        }

        .author-thumb .thumbnail {
            position: relative;
            width: calc(100% * 0.6);
            aspect-ratio: 1;
            max-width: 150px;
            max-height: 150px;
            margin: 0 auto 5px;
            overflow: hidden;
            border-radius: 50%;
            background: #f0f0f0;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .author-thumb .thumbnail:hover {
            border: 1px solid #1884cf;
        }

        .author-thumb .author-avatar {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .author-thumb .author-initial {
            display: none;
            align-items: center;
            justify-content: center;
            width: 100%;
            height: 100%;
            font-size: 48px;
            font-weight: bold;
            color: #888;
        }

        .author-thumb .desc {
            max-width: 150px;
            height: 28px;
            margin: 0 auto;
            font-size: 12px;
            color: #000;
            overflow: hidden;
            text-overflow: ellipsis;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            line-clamp: 2;
            -webkit-box-orient: vertical;
        }

        .badge-container {
            position: absolute;
            top: 8px;
            left: 8px;
            display: flex;
            flex-wrap: wrap;
            gap: 4px;
            max-width: 80%;
            z-index: 10;
        }

        .track-type-badge {
            position: relative;
            padding: 2px 8px;
            font-size: 10px;
            font-weight: bold;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            text-decoration: none;
            color: #fff;
            border-radius: 3px;
            z-index: 10;
            display: inline-flex;
            align-items: center;
            gap: 2px;
        }

        .track-type-badge.frhd {
            background-color: #1884cf;
        }

        .track-type-badge.bhr {
            background-color: #000;
        }

        .track-type-badge.cr {
            background-color: #aaa;
        }

        .track-type-badge.fr {
            background-color: #4a4a4a;
        }

        .track-type-badge.plus {
            background-color: #9b59b6;
        }

        .track-type-badge.playlist {
            background: linear-gradient(135deg, #667eea, #764ba2);
        }

        .live-badge {
            position: absolute;
            bottom: 8px;
            right: 8px;
            padding: 2px 8px;
            font-size: 10px;
            font-weight: bold;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            text-decoration: none;
            color: #fff;
            background-color: #d12929;
            border-radius: 3px;
            z-index: 10;
        }

        .special-badge {
            position: absolute;
            top: 8px;
            right: 8px;
            padding: 2px 8px;
            font-size: 10px;
            font-weight: bold;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            color: #fff;
            border-radius: 3px;
            z-index: 10;
        }

        .special-badge.daily {
            background: linear-gradient(135deg, #f2902e, #d12929);
        }

        .special-badge.random {
            background: linear-gradient(135deg, #a784c5, #1884cf);
        }

        .track-grid.hide-badges .track-type-badge,
        .track-grid.hide-badges .special-badge,
        .track-grid.hide-badges .ghost-badge,
        .track-grid.hide-badges .live-badge,
        .track-grid.hide-badges .playlist-count-badge {
            display: none;
        }

        .track-grid.hide-titles .desc {
            display: none;
        }

        .loading-indicator {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            font-size: 12px;
            color: #888;
        }

        .loading-indicator.hidden {
            display: none;
        }

        .no-results {
            width: 100%;
            padding: 40px 20px;
            text-align: center;
            color: #888;
        }

        .no-results h2 {
            margin-bottom: 10px;
            color: #aaa;
        }

        .track-count {
            margin-bottom: 10px;
            font: 10px eiven;
            letter-spacing: 1px;
            color: #888;
        }

        @media (max-width: 1020px) {

            .track-item,
            .author-item {
                width: calc(25% - 8px);
            }
        }

        @media (max-width: 860px) {

            .track-item,
            .author-item {
                width: calc(33.333% - 7px);
            }
        }

        @media (max-width: 640px) {

            .track-item,
            .author-item {
                width: calc(50% - 5px);
            }
        }

        @media (max-width: 600px) {
            .controls-row {
                justify-content: center;
            }
        }

        @media (max-width: 560px) {

            .track-item,
            .author-item {
                width: calc(50% - 5px);
            }
        }

        @media (max-width: 500px) {
            .controls-row {
                flex-direction: column;
                align-items: center;
            }
        }

        @media (max-width: 400px) {

            .track-item,
            .author-item {
                width: 100%;
            }
        }

        /* ===== PLAYLIST CARD ===== */
        .playlist-item {
            width: calc(20% - 8px);
            padding: 0;
            margin-bottom: 0;
            box-sizing: border-box;
        }

        .playlist-thumb {
            width: 100%;
            text-align: center;
        }

        .playlist-thumb .thumbnail {
            position: relative;
            aspect-ratio: 5 / 3;
            max-width: 250px;
            max-height: 150px;
            margin: 0 auto 5px;
            overflow: hidden;
            border-radius: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 64px;
            background: linear-gradient(135deg, #f5f5f5, #e0e0e0);
        }

        .playlist-thumb .thumbnail:hover {
            border: 1px solid #1884cf;
        }

        .playlist-thumb .thumbnail img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .playlist-thumb .playlist-icon-large {
            font-size: 48px;
        }

        .playlist-thumb .desc {
            max-width: 250px;
            height: 28px;
            margin: 0 auto;
            font-size: 12px;
            color: #000;
            overflow: hidden;
            text-overflow: ellipsis;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            line-clamp: 2;
            -webkit-box-orient: vertical;
        }

        .playlist-count-badge {
            position: absolute;
            bottom: 8px;
            right: 8px;
            padding: 2px 8px;
            color: #fff;
            font-family: Ubuntu, "Helvetica Neue", Helvetica, Arial, sans-serif;
            font-size: 10px;
            font-weight: bold;
            letter-spacing: 0.5px;
            background-color: #aaa;
            border-radius: 3px;
            z-index: 10;
        }

        @media (max-width: 1020px) {
            .playlist-item {
                width: calc(25% - 8px);
            }
        }

        @media (max-width: 860px) {
            .playlist-item {
                width: calc(33.333% - 7px);
            }
        }

        @media (max-width: 640px) {
            .playlist-item {
                width: calc(50% - 5px);
            }
        }

        @media (max-width: 400px) {
            .playlist-item {
                width: 100%;
            }
        }

        .ghost-badge {
            position: absolute;
            bottom: 8px;
            right: 8px;
            display: inline-flex;
            align-items: center;
            gap: 2px;
            padding: 2px 8px;
            font-size: 10px;
            font-weight: bold;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            color: #fff;
            background-color: #aaa;
            border-radius: 3px;
            z-index: 10;
        }

        .ghost-time {
            font-family: Ubuntu, "Helvetica Neue", Helvetica, Arial, sans-serif;
            font-size: 10px;
            font-weight: bold;
            letter-spacing: 0.5px;
            color: #fff;
        }

        .ghost-badge-sprite {
            display: inline-block;
            width: 47px;
            height: 32px;
            background-image: url('assets/images/gui/editor_gui.png');
            background-size: 512px 164px;
            background-repeat: no-repeat;
            background-position: -47px -132px;
            transform: scale(0.5);
            transform-origin: right center;
            margin: -8px -4px -8px -20px;
        }

        .ghost-badge:hover .ghost-badge-sprite {
            background-position: 0 -132px;
        }
    </style>
</head>

<body>

    <div id="content" class="container clearfix">
        <div class="container">
            <div class="sticky-header">
                <div class="controls-row">
                    <div class="type-filters">
                        <strong>
                            <span class="track-type-filter" data-type="db"
                                style="color: <%= type === 'db' ? '#000' : '#aaa' %>">
                                <span class="type-filter-link" style="color: inherit;">DB</span>
                            </span>
                            /
                            <span class="track-type-filter" data-type="frhd"
                                style="color: <%= type === 'frhd' ? '#000' : '#aaa' %>">
                                <span class="type-filter-link" style="color: inherit;">FRHD</span>
                            </span>
                            /
                            <span class="track-type-filter" data-type="bhr"
                                style="color: <%= type === 'bhr' ? '#000' : '#aaa' %>">
                                <span class="type-filter-link" style="color: inherit;">BHR</span>
                            </span>
                            /
                            <span class="track-type-filter" data-type="cr"
                                style="color: <%= type === 'cr' ? '#000' : '#aaa' %>">
                                <span class="type-filter-link" style="color: inherit;">CR</span>
                            </span>
                            /
                            <span class="track-type-filter" data-type="plus"
                                style="color: <%= type === 'plus' ? '#000' : '#aaa' %>">
                                <span class="type-filter-link" style="color: inherit;">+</span>
                            </span>
                        </strong>
                    </div>

                    <div class="type-filters">
                        <strong>
                            <span class="track-type-filter" data-mode="tracks"
                                style="color: <%= type !== 'user' && type !== 'ghosts' ? '#000' : '#aaa' %>">
                                <span class="type-filter-link" style="color: inherit;">TRACKS</span>
                            </span>
                            /
                            <span class="track-type-filter" data-mode="ghosts"
                                style="color: <%= type === 'ghosts' ? '#000' : '#aaa' %>">
                                <span class="type-filter-link" style="color: inherit;">GHOSTS</span>
                            </span>
                            /
                            <span class="track-type-filter" data-mode="user"
                                style="color: <%= type === 'user' ? '#000' : '#aaa' %>">
                                <span class="type-filter-link" style="color: inherit;">PLAYERS</span>
                            </span>
                        </strong>
                    </div>

                    <div class="toggle-group">
                        <label class="toggle-label">
                            <input type="checkbox" id="toggle-badges" checked>
                            Badges
                        </label>
                        <label class="toggle-label">
                            <input type="checkbox" id="toggle-titles" checked>
                            Titles
                        </label>
                    </div>

                    <div class="search-sort-group">
                        <input type="text" id="search-input" class="search-input" placeholder="Search..."
                            value="<%= query %>" aria-label="Search track archive">

                        <select id="sort-select" class="sort-select">
                            <option value="shuffle-desc" <%=sortBy==='shuffle' ? 'selected' : '' %>>Shuffle</option>
                            <option value="id-desc" <%=sortBy==='id' && sortOrder==='desc' ? 'selected' : '' %>>Newest
                            </option>
                            <option value="id-asc" <%=sortBy==='id' && sortOrder==='asc' ? 'selected' : '' %>>Oldest
                            </option>
                            <option value="name-asc" <%=sortBy==='name' && sortOrder==='asc' ? 'selected' : '' %>>Name
                                A-Z</option>
                            <option value="name-desc" <%=sortBy==='name' && sortOrder==='desc' ? 'selected' : '' %>>Name
                                Z-A</option>
                            <option value="upvotes-desc" <%=sortBy==='upvotes' && sortOrder==='desc' ? 'selected' : ''
                                %>>Most Upvotes</option>
                            <option value="downvotes-desc" <%=sortBy==='downvotes' && sortOrder==='desc' ? 'selected'
                                : '' %>>Most Downvotes
                            </option>
                            <option value="size-desc" <%=sortBy==='size' && sortOrder==='desc' ? 'selected' : '' %>
                                >Largest</option>
                            <option value="size-asc" <%=sortBy==='size' && sortOrder==='asc' ? 'selected' : '' %>
                                >Smallest</option>
                            <option value="plays-desc" <%=sortBy==='plays' && sortOrder==='desc' ? 'selected' : '' %>
                                >Most Plays</option>
                            <option value="plays-asc" <%=sortBy==='plays' && sortOrder==='asc' ? 'selected' : '' %>
                                >Least Plays</option>
                            <option value="published-desc" <%=sortBy==='published' && sortOrder==='desc' ? 'selected'
                                : '' %>>Recently Published
                            </option>
                            <option value="published-asc" <%=sortBy==='published' && sortOrder==='asc' ? 'selected' : ''
                                %>>Earliest Published
                            </option>
                        </select>
                    </div>
                </div>
            </div>

            <div id="track-grid" class="track-grid"></div>
        </div>
    </div>

<script>
const state = {
    type: '<%= type %>',
    mode: '<%= type === "user" ? "user" : (type === "playlist" ? "playlist" : "tracks") %>',
    query: '<%= query %>',
    sortBy: '<%= sortBy || "shuffle" %>',
    sortOrder: '<%= sortOrder %>',
    page: 1,
    perPage: 24,
    hasMore: true,
    isLoading: false,
    author: '',
    playlist: '',
    authorPlatform: '<%= type === "user" || type === "playlist" ? "db" : type %>',
    showGhostsOnly: false
};

let currentFetchController = null;

const trackGrid = document.getElementById('track-grid');
const searchInput = document.getElementById('search-input');
const sortSelect = document.getElementById('sort-select');
const typeFilters = document.querySelectorAll('.track-type-filter');

function sendToParent(trackUrl, trackName) {
    if (!trackUrl) return;
    const message = {
        action: "linkClicked",
        url: trackUrl,
        name: trackName || trackUrl
    };
    if (window.self !== window.top) {
        window.parent.postMessage(message, "*");
    }
}

function handleThumbnailFallback(img) {
    img.onerror = null;
    img.src = '/data/bhr/thumbnails/default.png';
}
window.handleThumbnailFallback = handleThumbnailFallback;

function updateURL() {
    const params = new URLSearchParams();
    params.set('type', state.type);
    params.set('sort', state.sortBy);
    params.set('order', state.sortOrder);
    if (state.query) params.set('q', state.query);
    if (state.author) params.set('author', state.author);
    if (state.playlist) params.set('playlist', state.playlist);

    const newURL = `/db?${params.toString()}`;
    history.replaceState(state, '', newURL);
}

function updateFilterStyles() {
    document.querySelectorAll('.track-type-filter').forEach(filter => {
        const filterType = filter.dataset.type;
        const mode = filter.dataset.mode;

        if (mode === 'tracks') {
            filter.style.color = state.mode === 'tracks' ? '#000' : '#aaa';
        } else if (mode === 'ghosts') {
            filter.style.color = state.mode === 'ghosts' ? '#000' : '#aaa';
        } else if (mode === 'user') {
            filter.style.color = state.mode === 'user' ? '#000' : '#aaa';
        } else if (mode === 'playlist') {
            filter.style.color = state.mode === 'playlist' ? '#000' : '#aaa';
        } else if (filterType) {
            filter.style.color = filterType === state.authorPlatform ? '#000' : '#aaa';
        }
    });
}

function getBadgeText(type) {
    const badges = { 'bhr': 'BHR', 'cr': 'CR', 'frhd': 'FRHD', 'fr': 'FR' };
    return badges[type] || type.toUpperCase();
}

function getSortValueDisplay(track, sortBy) {
    switch (sortBy) {
        case 'upvotes':
            if (track.type === 'cr' && track.votes !== null) {
                return `(${track.votes})`;
            }
            return track.upvotes ? `(${track.upvotes})` : '';
        case 'downvotes':
            if (track.type === 'cr' && track.votes !== null) {
                return `(${track.votes})`;
            }
            return track.downvotes ? `(${track.downvotes})` : '';
        case 'plays':
            return track.plays ? `(${track.plays})` : '';
        case 'size':
            return track.size ? `(${formatSize(track.size)})` : '';
        case 'favorites':
            return track.favorites ? `(${track.favorites})` : '';
        case 'published':
            return track.published ? `(${track.published})` : '';
        default:
            return '';
    }
}

function formatSize(bytes) {
    if (bytes >= 1000000) return (bytes / 1000000).toFixed(1) + 'M';
    if (bytes >= 1000) return (bytes / 1000).toFixed(1) + 'K';
    return bytes;
}

let liveSessions = {};

let playlistsData = [];

async function fetchPlaylists() {
    try {
        const response = await fetch('/api/playlists');
        const data = await response.json();
        playlistsData = data.playlists;
    } catch (error) {
        console.error('Error fetching playlists:', error);
    }
}

function renderAuthorCard(authorData) {
    const displayName = authorData.displayName || authorData.canonical || 'Unknown';
    const initial = displayName[0].toUpperCase();
    const avatarUrl = `/avatars/${authorData.canonical}.png`;

    return `
<div class="author-item">
    <div class="author-thumb">
        <a href="/db?author=${encodeURIComponent(displayName)}" class="author-link-card">
            <div class="thumbnail">
                <img class="author-avatar" 
                     src="${avatarUrl}" 
                     alt="${displayName}"
                     loading="lazy"
                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                <span class="author-initial" style="display: none;">${initial}</span>
            </div>
        </a>
        <p class="desc">
            <strong>${displayName}</strong>
        </p>
    </div>
</div>
`;
}


function renderTrackCard(track) {
    if (track.type === 'user') {
        return renderAuthorCard(track);
    }
    const sortValue = getSortValueDisplay(track, state.sortBy);

    const effectiveType = track.urlType || track.type;
    const effectiveId = track.urlId || track.slug || track.id;
    const urlType = effectiveType === 'plus' ? 't' : effectiveType;
    const trackUrl = `/${urlType}/${effectiveId}`;

    const liveSessionKey = `${effectiveType}/${effectiveId}`;
    const playerCount = liveSessions[liveSessionKey] || 0;
    const liveBadge = playerCount > 0
        ? `<span class="live-badge">LIVE</span>`
        : '';

    // show when in ghosts mode or when track has ghost data
    const hasGhost = track.hasGhost || track.ghoster;
    const ghostBadge = (state.mode === 'ghosts' || hasGhost)
        ? `<div class="ghost-badge">
        <span class="ghost-time">${track.ghostTime || '--:--.--'}</span>
        <span class="ghost-badge-sprite"></span>
       </div>`
        : '';

    const badges = track.badges || [track.type];
    const badgeHtml = badges.map(type => {
        const badgeText = getBadgeText(type);
        return `<span class="track-type-badge ${type}">${badgeText}</span>`;
    }).join('');

    let authorsHtml = '';
    if (track.authorsArray && track.authorsArray.length > 0) {
        const filteredAuthors = track.authorsArray.filter(a => a);
        const maxAuthors = 3;
        const displayAuthors = filteredAuthors.slice(0, maxAuthors);
        const remainingCount = filteredAuthors.length - maxAuthors;

        const authorLinks = displayAuthors
            .map(author => `<a href="/db?author=${encodeURIComponent(author)}" class="author-link"><strong>${author}</strong></a>`)
            .join(', ');

        authorsHtml = authorLinks;

        if (remainingCount > 0) {
            authorsHtml += ` <span class="more-authors">+${remainingCount}</span>`;
        }
    } else {
        const firstAuthor = track.username || track.authors || 'Unknown';
        authorsHtml = `<a href="/db?author=${encodeURIComponent(firstAuthor)}" class="author-link"><strong>${firstAuthor}</strong></a>`;
    }

    return `
<div class="track-item" data-track-type="${track.type}">
    <div class="track-thumb">
        <a href="${trackUrl}" class="track-link">
            <div class="thumbnail">
                <div class="badge-container">${badgeHtml}</div>
                ${liveBadge}
                ${ghostBadge}
                <img class="track-thumbnail" 
                     src="${trackUrl}.png" 
                     alt="${track.name}"
                     loading="lazy"
                     onerror="handleThumbnailFallback(this)">
            </div>
        </a>
        <p class="desc" style="margin-bottom: 0px">
            ${sortValue ? `<span class="sort-value">${sortValue}</span> ` : ''}<a href="${trackUrl}" class="track-link" style="color: inherit; text-decoration: none;">${track.name}</a>
            by ${authorsHtml}
        </p>
    </div>
</div>
`;
}

function renderPlaylistCards() {
    if (!playlistsData || playlistsData.length === 0) return '';
    
    return playlistsData.map(playlist => {
        const thumbnail = playlist.thumbnail || '/data/default-thumbnail.png';
        const username = playlist.username || 'Unknown';
        
        return `
<div class="track-item playlist-card" data-playlist-id="${playlist.id}">
    <div class="track-thumb">
        <a href="#" class="playlist-link" data-playlist-id="${playlist.id}">
            <div class="thumbnail">
                <div class="badge-container">
                    <span class="track-type-badge playlist" style="background: ${playlist.color || '#666'};">PLAYLIST</span>
                </div>
                <span class="playlist-count-badge">${playlist.trackCount} tracks</span>
                <img class="track-thumbnail" 
                     src="${thumbnail}" 
                     alt="${playlist.name}"
                     loading="lazy"
                     onerror="handleThumbnailFallback(this)">
            </div>
        </a>
        <p class="desc" style="margin-bottom: 0px">
            <a href="#" class="playlist-link" data-playlist-id="${playlist.id}" style="color: inherit; text-decoration: none;"><strong>${playlist.name}</strong></a>
            by <a href="/db?author=${encodeURIComponent(username)}" class="author-link"><strong>${username}</strong></a>
        </p>
    </div>
</div>
`;
    }).join('');
}

function createLoadingIndicator() {
    const loader = document.createElement('div');
    loader.className = 'loading-indicator';
    loader.id = 'loading-indicator';
    loader.innerHTML = 'Loading...';
    return loader;
}

let specialTracksCache = {};

async function fetchSpecialTracks(type) {
    if (type === 'db' || type === 'all' || type === 'user' || type === 'playlist') {
        return { daily: null, random: null };
    }

    const cacheKey = type;

    if (specialTracksCache[cacheKey]) {
        return specialTracksCache[cacheKey];
    }

    try {
        const [dailyRes, randomRes] = await Promise.all([
            fetch(`/api/daily/${type}`),
            fetch(`/api/random/${type}`)
        ]);

        const daily = dailyRes.ok ? await dailyRes.json() : null;
        const random = randomRes.ok ? await randomRes.json() : null;

        specialTracksCache[cacheKey] = { daily, random };
        return { daily, random };
    } catch (error) {
        console.error('Error fetching special tracks:', error);
        return { daily: null, random: null };
    }
}

function renderSpecialTrackCard(track) {
    if (!track || state.sortBy !== 'shuffle') return '';

    const urlType = track.type === 'plus' ? 't' : track.type;
    const trackUrl = track.url || `/${urlType}/${track.trackId}`;
    const badgeText = getBadgeText(track.type);
    const specialLabel = track.specialType === 'daily' ? 'DAILY' : 'RANDOM';

    let authorsHtml = '';
    let authors = track.authors;
    if (typeof authors === 'string' && authors.startsWith('[')) {
        try {
            const authorsArray = JSON.parse(authors.replace(/""/g, '"'));
            authorsHtml = authorsArray.slice(0, 3)
                .map(a => `<a href="/db?author=${encodeURIComponent(a)}" class="author-link"><strong>${a}</strong></a>`)
                .join(', ');
        } catch (e) {
            authorsHtml = `<strong>${authors}</strong>`;
        }
    } else if (authors) {
        authorsHtml = `<a href="/db?author=${encodeURIComponent(authors)}" class="author-link"><strong>${authors}</strong></a>`;
    } else {
        authorsHtml = '<strong>Unknown</strong>';
    }

    return `
<div class="track-item" data-track-type="${track.type}" data-special="${track.specialType}">
    <div class="track-thumb">
        <a href="${trackUrl}" class="track-link">
            <div class="thumbnail">
                <div class="badge-container">
                    <span class="track-type-badge ${track.type}">${badgeText}</span>
                </div>
                <span class="special-badge ${track.specialType}">${specialLabel}</span>
                <img class="track-thumbnail" 
                     src="${track.thumbnail}" 
                     alt="${track.name}"
                     loading="lazy"
                     onerror="handleThumbnailFallback(this)">
            </div>
        </a>
        <p class="desc" style="margin-bottom: 0px">
            <a href="${trackUrl}" class="track-link" style="color: inherit; text-decoration: none;">${track.name}</a>
            by ${authorsHtml}
        </p>
    </div>
</div>
`;
}

async function getSpecialCards(type) {
    let html = '';
    
    if (type === 'user' || type === 'playlist') {
        return '';
    }
    
    if (type !== 'db' && type !== 'all') {
        const { daily, random } = await fetchSpecialTracks(type);
        if (daily) html += renderSpecialTrackCard(daily);
        if (random) html += renderSpecialTrackCard(random);
    }
    
    if (type === 'db') {
        html += renderPlaylistCards();
    }
    
    return html;
}

async function fetchTracks(append = false) {
    if (state.isLoading && !append) {
        if (currentFetchController) {
            currentFetchController.abort();
        }
    }
    
    if (append && !state.hasMore) return;

    state.isLoading = true;
    
    currentFetchController = new AbortController();
    const signal = currentFetchController.signal;

    let loader = document.getElementById('loading-indicator');
    if (!loader) {
        loader = createLoadingIndicator();
        trackGrid.appendChild(loader);
    }
    loader.classList.remove('hidden');

    const params = new URLSearchParams();
    params.set('page', state.page);
    params.set('perPage', state.perPage);
    params.set('sort', state.sortBy);
    params.set('order', state.sortOrder);
    params.set('type', state.type);
    if (state.query) params.set('q', state.query);
    if (state.author) params.set('author', state.author);
    if (state.playlist) params.set('playlist', state.playlist);
    if (state.showGhostsOnly) params.set('ghosts', 'true');

    let endpoint;

    if (state.mode === 'user') {
        endpoint = '/api/authors-by-platform';
        params.set('platform', state.authorPlatform);
    } else if (state.mode === 'playlist') {
        endpoint = '/api/playlists';
    } else {
        endpoint = '/api/db';
    }

    try {
        const response = await fetch(`${endpoint}?${params.toString()}`, { signal });
        
        if (signal.aborted) {
            return;
        }
        
        const data = await response.json();

        loader.remove();

        if (state.mode === 'playlist') {
            const playlists = data.playlists || [];

            let filteredPlaylists = playlists;
            if (state.query) {
                const lowerQuery = state.query.toLowerCase();
                filteredPlaylists = playlists.filter(p =>
                    p.name.toLowerCase().includes(lowerQuery) ||
                    (p.description && p.description.toLowerCase().includes(lowerQuery))
                );
            }

            state.hasMore = false;

            if (filteredPlaylists.length === 0) {
                trackGrid.innerHTML = `
                    <div class="no-results">
                        <h2>No playlists found</h2>
                        <p>Try a different search term</p>
                    </div>
                `;
            } else {
                trackGrid.innerHTML = filteredPlaylists.map(renderPlaylistCard).join('');
            }
        } else {
            const tracks = data.tracks || data.users || [];

            if (data.allLoaded) {
                state.hasMore = false;
            } else if (data.pagination) {
                state.hasMore = state.page < data.pagination.totalPages;
            } else {
                state.hasMore = false;
            }

            if (tracks.length === 0 && !append) {
                trackGrid.innerHTML = `
                    <div class="no-results">
                        <h2>No ${state.mode === 'user' ? 'authors' : 'tracks'} found</h2>
                        <p>Try a different search term or filter</p>
                    </div>
                `;
            } else {
                const trackHTML = tracks.map(renderTrackCard).join('');

                if (append) {
                    trackGrid.insertAdjacentHTML('beforeend', trackHTML);
                } else {
                    let specialCards = '';
                    if (state.mode === 'tracks' && state.page === 1 && !state.query && !state.author && !state.playlist) {
                        specialCards = await getSpecialCards(state.type);
                    }
                    trackGrid.innerHTML = specialCards + trackHTML;
                }

                if (state.hasMore) {
                    loader = createLoadingIndicator();
                    loader.classList.add('hidden');
                    trackGrid.appendChild(loader);
                }
            }
        }

        if (!append) {
            updateURL();
            updateFilterStyles();
        }

        state.isLoading = false;
        currentFetchController = null;

        if (state.hasMore && document.documentElement.scrollHeight <= window.innerHeight) {
            setTimeout(() => {
                if (!state.isLoading && state.hasMore) {
                    state.page++;
                    fetchTracks(true);
                }
            }, 100);
        }

    } catch (error) {
        if (error.name === 'AbortError') {
            console.log('Fetch aborted');
            return;
        }
        
        console.error('Error fetching:', error);
        state.isLoading = false;
        currentFetchController = null;
        
        if (!append) {
            trackGrid.innerHTML = `
                <div class="no-results">
                    <h2>Error loading content</h2>
                    <p>Please try again later</p>
                </div>
            `;
        }
    }
}

function showFilterIndicator(html, type) {
    const indicator = document.createElement('div');
    indicator.className = 'filter-indicator';
    indicator.dataset.filterType = type;
    indicator.innerHTML = `
        ${html}
        <span class="clear-filter" onclick="clearFilter('${type}')">×</span>
    `;
    document.querySelector('.controls-row').appendChild(indicator);

    requestAnimationFrame(() => {
        adjustContentPadding();
    });
}

function setAuthorFilter(authorName) {
    state.author = authorName;
    state.playlist = '';
    state.mode = 'tracks';
    clearFilterIndicators();

    fetch(`/api/user-aliases/${encodeURIComponent(authorName)}?type=${state.type}`)
        .then(res => res.json())
        .then(data => {
            let displayText = `<strong>${authorName}</strong>`;
            const otherNames = data.aliases.filter(a => 
                a.toLowerCase() !== authorName.toLowerCase()
            );
            if (otherNames.length > 0) {
                displayText += ` (also: ${otherNames.join(', ')})`;
            }
            displayText += ` (${data.trackCount} tracks)`;
            showFilterIndicator(displayText, 'author');
        })
        .catch(() => {
            showFilterIndicator(`<strong>${authorName}</strong>`, 'author');
        });

    resetAndFetch();
}

function setPlaylistFilter(playlistId) {
    const playlist = playlistsData.find(p => p.id === playlistId);
    if (!playlist) return;

    state.playlist = playlistId;
    state.author = '';
    state.mode = 'tracks';
    state.type = state.authorPlatform;

    clearFilterIndicators();
    showFilterIndicator(
        `<strong>${playlist.name}</strong> (${playlist.trackCount || 0} tracks)`,
        'playlist'
    );
    updateFilterStyles();
    resetAndFetch();
}

function clearFilterIndicators() {
    document.querySelectorAll('.filter-indicator').forEach(el => el.remove());
    requestAnimationFrame(() => {
        adjustContentPadding();
    });
}

function clearFilter(type) {
    if (type === 'author') {
        state.author = '';
    } else if (type === 'playlist') {
        state.playlist = '';
    }
    clearFilterIndicators();
    updateURL();
    resetAndFetch();
}

function loadMore() {
    if (state.hasMore && !state.isLoading) {
        state.page++;
        fetchTracks(true);
    }
}

function resetAndFetch() {
    if (currentFetchController) {
        currentFetchController.abort();
        currentFetchController = null;
    }
    
    state.page = 1;
    state.hasMore = true;
    state.isLoading = false;
    trackGrid.innerHTML = '';
    fetchTracks(false);
}

function handleScroll() {
    if (state.isLoading || !state.hasMore) return;

    const scrollBottom = document.documentElement.scrollHeight - window.innerHeight - window.scrollY;
    const needFill = document.documentElement.scrollHeight <= window.innerHeight;

    if (scrollBottom < 1000 || needFill) {
        loadMore();
    }
}

function adjustContentPadding() {
    const header = document.querySelector('.sticky-header');
    const content = document.getElementById('content');
    content.style.paddingTop = header.offsetHeight + 'px';
}

window.addEventListener('resize', adjustContentPadding);

function initializeLinkHijacking() {
    if (window.self === window.top) {
        console.log("DB: Running as top window. Links will navigate normally.");
        return;
    }

    const trackUrlRegex = /\/(frhd|bhr|cr|u)\/([a-zA-Z0-9_-]+|daily|random)(?:\/([a-zA-Z0-9_-]+))?/i;

    document.getElementById('content').addEventListener('click', function (event) {
        if (event.defaultPrevented) return;
        
        const targetElement = event.target.closest('a');
        
        if (!targetElement) return;
        
        if (targetElement.classList.contains('playlist-link')) return;
        
        const href = targetElement.getAttribute('href');

        if (href && href !== '#' && !href.startsWith('javascript:')) {
            const fullUrl = targetElement.href;

            if (fullUrl.match(trackUrlRegex)) {
                event.preventDefault();
                event.stopPropagation();
                event.stopImmediatePropagation();

                const descElement = targetElement.closest('.track-thumb')?.querySelector('.desc');
                const trackName = descElement ? descElement.textContent.trim() : targetElement.textContent.trim() || href;

                sendToParent(fullUrl, trackName);
            }
        }
    }, true);

    console.log("DB: Track link interception initialized.");
}

function updateAuthorIndicator(authorName, type) {
    fetch(`/api/user-aliases/${encodeURIComponent(authorName)}?type=${type}`)
        .then(res => res.json())
        .then(data => {
            const existingIndicator = document.querySelector('.filter-indicator[data-filter-type="author"]');
            if (existingIndicator) {
                let displayText = `<strong>${authorName}</strong>`;
                const otherNames = data.aliases.filter(a => 
                    a.toLowerCase() !== authorName.toLowerCase()
                );
                if (otherNames.length > 0) {
                    displayText += ` (also: ${otherNames.join(', ')})`;
                }
                displayText += ` (${data.trackCount} tracks)`;
                existingIndicator.innerHTML = `
                    ${displayText}
                    <span class="clear-filter" onclick="clearFilter('author')">×</span>
                `;
            }
        })
        .catch(() => {});
}

function initEventListeners() {
    document.querySelectorAll('.track-type-filter').forEach(filter => {
        filter.addEventListener('click', () => {
            const mode = filter.dataset.mode;
            const newType = filter.dataset.type;

            if (mode === 'tracks') {
                state.mode = 'tracks';
                state.type = state.authorPlatform;
                state.playlist = '';
                state.showGhostsOnly = false;
                clearFilterIndicators();
            } else if (mode === 'ghosts') {
                state.mode = 'ghosts';
                state.type = state.authorPlatform;
                state.playlist = '';
                state.showGhostsOnly = true;
                clearFilterIndicators();
            } else if (mode === 'user') {
                state.mode = 'user';
                state.type = 'user';
                state.showGhostsOnly = false;
            } else if (mode === 'playlist') {
                state.mode = 'playlist';
                state.type = 'playlist';
                state.playlist = '';
                state.showGhostsOnly = false;
                clearFilterIndicators();
            } else if (newType) {
                state.authorPlatform = newType;
                state.type = newType;
                if (state.author) {
                updateAuthorIndicator(state.author, newType);
                }
            }

            updateFilterStyles();
            resetAndFetch();
        });
    });

    trackGrid.addEventListener('click', (e) => {
        const playlistLink = e.target.closest('.playlist-link');
        if (playlistLink) {
            e.preventDefault();
            const playlistId = playlistLink.dataset.playlistId;
            setPlaylistFilter(playlistId);
        }
    });

    let searchTimeout;
    searchInput.addEventListener('input', (e) => {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(() => {
            state.query = e.target.value;
            resetAndFetch();
        }, 300);
    });

    sortSelect.addEventListener('change', (e) => {
        const [sortBy, sortOrder] = e.target.value.split('-');
        state.sortBy = sortBy;
        state.sortOrder = sortOrder;
        resetAndFetch();
    });

    const urlParams = new URLSearchParams(window.location.search);
    const authorParam = urlParams.get('author');
    const playlistParam = urlParams.get('playlist');

    if (authorParam) {
    state.author = authorParam;
    fetch(`/api/user-aliases/${encodeURIComponent(authorParam)}?type=${state.type}`)
        .then(res => res.json())
        .then(data => {
            let displayText = `<strong>${authorParam}</strong>`;
            const otherNames = data.aliases.filter(a => 
                a.toLowerCase() !== authorParam.toLowerCase()
            );
            if (otherNames.length > 0) {
                displayText += ` (also: ${otherNames.join(', ')})`;
            }
            displayText += ` (${data.trackCount} tracks)`;
            showFilterIndicator(displayText, 'author');
        })
        .catch(() => {
            showFilterIndicator(`<strong>${authorParam}</strong>`, 'author');
        });
    }

    if (playlistParam && !authorParam) {
        state.playlist = playlistParam;
        setTimeout(() => {
            const playlist = playlistsData.find(p => p.id === playlistParam);
            if (playlist) {
                showFilterIndicator(`<strong>${playlist.name}</strong> (${playlist.trackCount} tracks)`, 'playlist');
            }
        }, 200);
    }


    window.addEventListener('scroll', handleScroll);
}

window.setAuthorFilter = setAuthorFilter;
window.setPlaylistFilter = setPlaylistFilter;
window.clearFilter = clearFilter;


function clearAuthorFilter() {
    state.author = '';
    const params = new URLSearchParams(window.location.search);
    params.delete('author');
    window.history.replaceState({}, '', `/db?${params.toString()}`);
    document.querySelector('.author-filter-indicator')?.remove();

    requestAnimationFrame(() => {
        adjustContentPadding();
    });

    resetAndFetch();
}


function initToggles() {
    const toggleBadges = document.getElementById('toggle-badges');
    const toggleTitles = document.getElementById('toggle-titles');

    toggleBadges.addEventListener('change', (e) => {
        trackGrid.classList.toggle('hide-badges', !e.target.checked);
        setTimeout(handleScroll, 100);
    });

    toggleTitles.addEventListener('change', (e) => {
        trackGrid.classList.toggle('hide-titles', !e.target.checked);
        setTimeout(handleScroll, 100);
    });
}

async function fetchLiveSessions() {
    try {
        const response = await fetch('/api/live-sessions');
        liveSessions = await response.json();
    } catch (error) {
        console.error('Error fetching live sessions:', error);
        liveSessions = {};
    }
}

setInterval(fetchLiveSessions, 10000);

document.addEventListener('DOMContentLoaded', async () => {
    await fetchLiveSessions();
    await fetchPlaylists();
    initEventListeners();
    initToggles();
    initializeLinkHijacking();
    fetchTracks(false);
    adjustContentPadding();
});
</script>
</body>

</html>