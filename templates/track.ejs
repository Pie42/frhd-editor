<!DOCTYPE HTML>
<html>

<head>
    <!--<title>free rider - draw</title>-->
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="chrome=1, IE=9">

    <meta name="format-detection" content="telephone=no">
    <meta name="HandheldFriendly" content="true" />
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black">
    <meta name="format-detection" content="telephone=no">
    <meta name="HandheldFriendly" content="true" />
    <meta name="robots" content="noindex,nofollow" w />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <meta name="apple-mobile-web-app-title" content="Phaser App">
    <meta name="viewport" content="initial-scale=1 maximum-scale=1 user-scalable=0 minimal-ui" />
    <meta name="format-detection" content="telephone=no">

    <title>
        <%= track.name || 'free rider - draw' %>
    </title>
    <meta name="author" content="<%= track.authors || 'Ness & Pie42' %>">
    <meta name="description" content="<%= (track.description || 'track editor v1.1').substring(0, 160) %>">

    <meta property="og:title" content="<%= track.name || 'free rider - draw' %> by <%= track.authors || 'Unknown' %>">
    <meta property="og:description" content="<%= (track.description || 'track editor v1.1').substring(0, 200) %>">
    <meta property="og:image" content="https://freerider.app/<%= track.type %>/<%= track.id %>.png">
    <meta property="og:url" content="<%= track.permalink || 'https://freerider.app' %>">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="freerider.app">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= track.name || 'free rider - draw' %>">
    <meta name="twitter:description" content="<%= (track.description || 'track editor v1.1').substring(0, 200) %>">
    <meta name="twitter:image" content="https://freerider.app/<%= track.type %>/<%= track.id %>.png">

    <% if (track.authors) { %>
        <meta name="author" content="<%= track.authors %>">
        <% } %>
            <% if (track.published) { %>
                <meta property="article:published_time" content="<%= track.published %>">
                <% } %>
                    <base href="/">
    
    <link rel="icon" href="https://freerider.app/favicon.ico" type="image/x-icon">
    <link type="text/css" rel="stylesheet" href="app.css"></link>
    <script defer data-domain="freerider.app" src="https://plausible.io/js/script.js"></script>

</head>
<body>
    <div id="game-container"></div>
    
    <script src="scripts/manifest.js"></script>

    <script src="scripts/settings.js"></script>
    
    <script src="scripts/offlineeditor.js"></script>

    <script type="text/plain" id="trackcode"><%= track.code %></script>
    
    <script>   
    const trackCode = document.getElementById('trackcode').textContent;

    GameManager.command("import", trackCode, true);
    GameSettings.trackName = "<%= track.name %>";
    GameSettings.id = "<%= track.id %>";
    GameSettings.type = "<%= track.type %>";
    GameSettings.userId = "<%= track.userId %>";
    GameSettings.pageName = "<%= track.pageName %>";
    GameSettings.code = trackCode

    GameSettings.authors = "<%= track.authors || 'Unknown' %>";
    GameSettings.thumbnail = "<%= track.thumbnail || '' %>";
    GameSettings.description = "<%= (track.description || '').replace(/\\/g, '\\\\').replace(/"/g, '\\"').replace(/\n/g, '\\n') %>";
    GameSettings.permalink = "<%= track.permalink || '' %>";
    GameSettings.published = "<%= track.published || '' %>";
    GameSettings.size = "<%= track.size || '' %>";

    GameSettings.forumUrl = "<%= track.forumUrl || 'https://forum.freerider.app/feed' %>";
    GameSettings.type === 'bhr' ? GameSettings.blackHat = true : false;

    document.title = "<%= track.name %>" || "free rider - draw";

    window.addEventListener("message", function (event) {
        if (event.data.action === "loggedIn") {
            GameSettings.beta = true;
            GameSettings.user = event.data.user;
        }
    })
    </script>
</body>
</html>